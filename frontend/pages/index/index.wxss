/* 首页样式 */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  padding: 60rpx 0 80rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 30rpx;
}

.content {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 30rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 40rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.card:last-child {
  border-bottom: none;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.card-icon image {
  width: 56rpx;
  height: 56rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
}

.card-arrow {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.3;
}
