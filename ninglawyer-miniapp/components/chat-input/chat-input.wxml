<!-- 输入框组件 -->
<view class="input-container">
  <!-- 图片预览 -->
  <view wx:if="{{imagePreview}}" class="image-preview">
    <image src="{{imagePreview}}" mode="aspectFill" class="preview-image"></image>
    <view class="image-close" bindtap="onRemoveImage">✕</view>
  </view>

  <!-- 输入框区域 -->
  <view class="input-box">
    <!-- 图片上传按钮 -->
    <view class="icon-button" bindtap="onChooseImage">
      <image src="/assets/icons/image.png" mode="aspectFit"></image>
    </view>

    <!-- 文本输入框 -->
    <view class="text-input-wrapper">
      <textarea
        class="text-input"
        value="{{inputValue}}"
        placeholder="{{placeholder}}"
        placeholder-class="placeholder"
        auto-height="{{true}}"
        maxlength="{{maxlength}}"
        adjust-position="{{true}}"
        cursor-spacing="{{10}}"
        show-confirm-bar="{{false}}"
        bindinput="onInput"
        bindconfirm="onSend"
        bindfocus="onFocus"
        bindblur="onBlur">
      </textarea>
    </view>

    <!-- 发送按钮 -->
    <view 
      class="send-button {{canSend ? 'active' : ''}}" 
      bindtap="onSend">
      <image src="/assets/icons/send.png" mode="aspectFit"></image>
    </view>
  </view>
</view>
