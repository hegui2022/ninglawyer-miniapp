<!-- 判例详情页面 -->
<view class="case-detail-page" wx:if="{{caseDetail}}">
  <view class="case-header">
    <text class="case-title">{{caseDetail.title}}</text>
    <view class="case-meta">
      <text class="case-court">{{caseDetail.court}}</text>
      <text class="case-no">{{caseDetail.caseNo}}</text>
    </view>
    <text class="case-date">{{caseDetail.date}}</text>
  </view>
  
  <view class="case-section">
    <text class="section-title">当事人</text>
    <view class="party-info">
      <text class="party-label">原告：</text>
      <text class="party-value">{{caseDetail.plaintiff}}</text>
    </view>
    <view class="party-info">
      <text class="party-label">被告：</text>
      <text class="party-value">{{caseDetail.defendant}}</text>
    </view>
  </view>
  
  <view class="case-section">
    <text class="section-title">基本事实</text>
    <text class="section-content">{{caseDetail.facts}}</text>
  </view>
  
  <view class="case-section">
    <text class="section-title">法院观点</text>
    <text class="section-content">{{caseDetail.opinion}}</text>
  </view>
  
  <view class="case-section">
    <text class="section-title">判决结果</text>
    <view class="result-box">
      <text class="result-text">{{caseDetail.result}}</text>
      <text class="result-amount" wx:if="{{caseDetail.amount}}">{{caseDetail.amount}}</text>
    </view>
  </view>
  
  <view class="case-section">
    <text class="section-title">法律依据</text>
    <text class="law-text">{{caseDetail.law}}</text>
  </view>
</view>
