/* pages/guide/article/article.wxss */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 80rpx;
}

/* 文章信息区 */
.article-info {
  padding: 24rpx 32rpx;
}

.article-tag {
  display: inline-flex;
  align-items: center;
  background-color: #E8F5E9;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #2E7D32;
  margin-right: 12rpx;
}

.tag-icon {
  font-size: 24rpx;
}

/* 内容区 */
.content-section {
  padding: 0 32rpx;
}

.content-item {
  display: flex;
  margin-bottom: 24rpx;
}

.item-number {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  flex-shrink: 0;
}

.item-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

.sub-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  margin: 32rpx 0;
  padding-left: 24rpx;
}

.content-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

/* 付费提示 */
.pay-prompt {
  margin: 32rpx 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.pay-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}
