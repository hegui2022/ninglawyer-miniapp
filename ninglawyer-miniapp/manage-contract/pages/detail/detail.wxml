<!-- 理约 - 合同详情 -->
<view class="detail-page">
  <view class="header-section" wx:if="{{contract}}">
    <text class="contract-name">{{contract.name}}</text>
    <view class="contract-meta">
      <text class="meta-item">{{contract.type}}</text>
      <text class="meta-item">金额: ¥{{contract.amount}}</text>
    </view>
  </view>
  
  <view class="info-section" wx:if="{{contract}}">
    <view class="section-title">合同信息</view>
    <view class="info-list">
      <view class="info-row">
        <text class="info-label">签订日期</text>
        <text class="info-value">{{contract.signDate}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">开始日期</text>
        <text class="info-value">{{contract.startDate}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">结束日期</text>
        <text class="info-value">{{contract.endDate}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">对方当事人</text>
        <text class="info-value">{{contract.party}}</text>
      </view>
    </view>
  </view>
  
  <view class="content-section" wx:if="{{contract}}">
    <view class="section-title">合同内容</view>
    <view class="content-text">{{contract.content}}</view>
  </view>
  
  <view class="action-section">
    <button class="btn-edit" bindtap="onEdit">编辑</button>
    <button class="btn-delete" bindtap="onDelete">删除</button>
  </view>
</view>
