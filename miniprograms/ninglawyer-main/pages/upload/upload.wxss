.upload-container { padding: 32rpx; }

.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fafafa;
}

.upload-icon { width: 96rpx; height: 96rpx; opacity: 0.3; margin-bottom: 24rpx; }
.upload-text { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.upload-hint { font-size: 24rpx; color: #999; }

.file-list { margin-top: 32rpx; }
.file-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; background: #fff;
  border-radius: 12rpx; margin-bottom: 16rpx;
}
.file-icon { width: 48rpx; height: 48rpx; }
.file-info { flex: 1; }
.file-name { display: block; font-size: 28rpx; color: #333; }
.file-size { display: block; font-size: 24rpx; color: #999; }
.file-status { font-size: 26rpx; color: #1890ff; }
