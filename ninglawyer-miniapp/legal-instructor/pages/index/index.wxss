/* 法律教官 - 首页样式 */
.index-page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-title {
  position: absolute;
  bottom: 60rpx;
  left: 32rpx;
  right: 32rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 统计数据 */
.stats-section {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  padding: 40rpx 0;
  margin-bottom: 16rpx;
}

.stats-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #07C160;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #999999;
}

/* 服务入口 */
.services-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #07C160;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.service-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  background: #E8F8F0;
  border-radius: 50%;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.service-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.service-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

/* 宁律师推荐 */
.lawyer-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.lawyer-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.lawyer-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
}

.lawyer-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.lawyer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.lawyer-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.lawyer-domain {
  font-size: 24rpx;
  color: #999999;
}

/* 快捷咨询 */
.quick-consult {
  padding: 32rpx;
}

.btn-primary {
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-large {
  width: 100%;
}
