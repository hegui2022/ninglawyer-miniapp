<!-- 防风险首页 -->
<view class="page">
  <view class="header">
    <view class="score-section">
      <text class="score-label">风险评分</text>
      <text class="score-value">{{score}}</text>
      <view class="risk-badge risk-{{riskLevel}}">{{riskLevel === 'low' ? '低风险' : riskLevel === 'medium' ? '中风险' : '高风险'}}</view>
    </view>
  </view>
  
  <view class="section">
    <view class="section-title">选择风险类型</view>
    <view class="category-list">
      <view class="category-item {{item.checked ? 'checked' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryChange" data-id="{{item.id}}">
        <view class="category-icon">
          <text class="icon-{{item.id}}">📋</text>
        </view>
        <view class="category-info">
          <text class="category-name">{{item.name}}</text>
          <view class="category-check" wx:if="{{item.checked}}">
            <text class="check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <button class="btn-submit" bindtap="onAnalyze" disabled="{{analyzing}}">
    {{analyzing ? '分析中...' : '开始分析'}}
  </button>
  
  <!-- 分析结果 -->
  <view class="result-section" wx:if="{{result}}">
    <view class="result-header">
      <text class="result-title">分析结果</text>
    </view>
    <view class="result-content">
      <view class="risk-item" wx:for="{{result.risks}}" wx:key="id">
        <text class="risk-title">{{item.title}}</text>
        <text class="risk-desc">{{item.description}}</text>
        <view class="risk-level risk-{{item.level}}">{{item.level === 'high' ? '高' : item.level === 'medium' ? '中' : '低'}}</view>
      </view>
    </view>
  </view>
</view>
