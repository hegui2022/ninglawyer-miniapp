<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="我的" showBack="{{false}}"></nav-bar>

  <!-- 个人信息区 -->
  <view class="profile-section">
    <!-- 头像 -->
    <view class="avatar-section">
      <view class="avatar">
        <text class="avatar-text">👤</text>
      </view>
    </view>

    <!-- 姓名与职位 -->
    <view class="info-section">
      <view class="info-main">
        <view class="info-left">
          <text class="name">三修</text>
          <text class="position">股东、董事、经理</text>
        </view>
        <!-- 功能按钮 -->
        <view class="info-button" bindtap="goToBooking">
          <text class="button-text">理约上海</text>
        </view>
      </view>

      <!-- 标签 -->
      <view class="tags-section">
        <view class="tag">
          <text class="tag-text">房地产</text>
        </view>
        <view class="tag">
          <text class="tag-text">上海浦东</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能入口列表 -->
  <view class="function-list">
    <!-- 我的公司 -->
    <view class="function-item" bindtap="goToFunction" data-type="company">
      <view class="function-icon company">
        <text class="icon-text">🏢</text>
      </view>
      <view class="function-info">
        <text class="function-name company">我的公司</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 我的岗位 -->
    <view class="function-item" bindtap="goToFunction" data-type="position">
      <view class="function-icon position">
        <text class="icon-text">💼</text>
      </view>
      <view class="function-info">
        <text class="function-name position">我的岗位</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- TabBar 组件 -->
  <tab-bar currentPath="/pages/profile/profile"></tab-bar>
</view>
