/* pages/scan/scan.wxss */

/* 扫描类型 */
.scan-types {
  margin-bottom: 24rpx;
}

.type-list {
  display: flex;
  flex-direction: column;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background-color: #ffffff;
  transition: all 0.3s;
}

.type-item.active {
  border-color: #07C160;
  background-color: rgba(7, 193, 96, 0.05);
}

.type-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.type-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.type-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.type-desc {
  font-size: 24rpx;
  color: #666666;
}

.type-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

/* 扫描范围 */
.scan-scope {
  margin-bottom: 24rpx;
}

.scope-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.scope-item {
  padding: 16rpx 32rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #ffffff;
  transition: all 0.3s;
}

.scope-item.active {
  border-color: #07C160;
  color: #07C160;
  background-color: rgba(7, 193, 96, 0.05);
}

.scope-text {
  font-size: 28rpx;
}

/* 扫描选项 */
.scan-options {
  margin-bottom: 24rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.option-item:last-child {
  border-bottom: none;
}

.option-label {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 扫描进度 */
.scan-progress {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}

.progress-bar {
  height: 8rpx;
  background-color: #e5e5e5;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #07C160 0%, #06A850 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-info {
  padding: 16rpx;
  background-color: #f7f7f7;
  border-radius: 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666666;
}

/* 扫描结果 */
.scan-result {
  margin-bottom: 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.result-badge {
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.result-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 24rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
}

.result-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
}

/* 风险列表 */
.risk-list {
  margin-bottom: 24rpx;
}

.risk-items {
  display: flex;
  flex-direction: column;
}

.risk-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
  border-left: 4rpx solid;
}

.risk-item.risk-high {
  border-left-color: #F44336;
}

.risk-item.risk-medium {
  border-left-color: #FF9800;
}

.risk-item.risk-low {
  border-left-color: #07C160;
}

.risk-left {
  flex: 1;
  display: flex;
  align-items: flex-start;
}

.risk-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.risk-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.risk-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.risk-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.risk-level {
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.risk-arrow {
  font-size: 28rpx;
  color: #999999;
}

/* 操作按钮 */
.action-buttons {
  padding: 24rpx 0;
}

.action-buttons .btn {
  margin-bottom: 16rpx;
}

.action-buttons .btn:last-child {
  margin-bottom: 0;
}
