<!--pages/guide/guide.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <!-- 自定义状态栏 -->
    <view class="status-bar">
      <view class="status-left">
        <text class="status-icon">📶</text>
        <text class="status-icon">📶</text>
      </view>
      <view class="status-center">12:00</view>
      <view class="status-right">
        <text class="status-icon">🔋</text>
      </view>
    </view>
    <!-- 标题栏 -->
    <view class="title-bar">
      <view class="title">指引</view>
    </view>
  </view>

  <!-- 内容列表区 -->
  <view class="content-list">
    <!-- 第一组卡片：个人信息 -->
    <view class="card-group">
      <!-- 头部信息 -->
      <view class="card-header">
        <view class="avatar">👤</view>
        <view class="card-title">个人信息</view>
        <view class="card-time">40 分钟前</view>
      </view>

      <!-- 横幅图片 -->
      <view class="banner-section">
        <view class="banner-placeholder">
          <text class="banner-icon">🌊</text>
        </view>
        <view class="banner-text">网络及数据安全技术措施</view>
      </view>

      <!-- 图文条目 -->
      <view class="item-row">
        <view class="item-title">敏感信息的处理</view>
        <view class="item-image">
          <text class="item-icon">🚗</text>
        </view>
      </view>

      <!-- 展开按钮 -->
      <view class="expand-section" bindtap="toggleExpand" data-index="0">
        <view class="expand-text">余下 2 篇</view>
        <view class="expand-icon {{expandState[0] ? 'rotate' : ''}}">▼</view>
      </view>

      <!-- 展开内容（默认隐藏） -->
      <view class="expand-content {{expandState[0] ? 'show' : 'hide'}}">
        <view class="item-row">
          <view class="item-title">数据加密技术要点</view>
          <view class="item-image">
            <text class="item-icon">🔐</text>
          </view>
        </view>
        <view class="item-row">
          <view class="item-title">个人信息保护合规</view>
          <view class="item-image">
            <text class="item-icon">🛡️</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 第二组卡片：税务规划 -->
    <view class="card-group">
      <!-- 头部信息 -->
      <view class="card-header">
        <view class="avatar">👤</view>
        <view class="card-title">税务规划</view>
        <view class="card-time">1 月 9 日</view>
      </view>

      <!-- 横幅图片 -->
      <view class="banner-section">
        <view class="banner-placeholder">
          <text class="banner-icon">🏙️</text>
        </view>
        <view class="banner-text">企业税务减免政策</view>
      </view>

      <!-- 图文条目 -->
      <view class="item-row">
        <view class="item-title">股权转让中的个人问题</view>
        <view class="item-image">
          <text class="item-icon">🚗</text>
        </view>
      </view>

      <!-- 展开按钮 -->
      <view class="expand-section" bindtap="toggleExpand" data-index="1">
        <view class="expand-text">余下 2 篇</view>
        <view class="expand-icon {{expandState[1] ? 'rotate' : ''}}">▼</view>
      </view>

      <!-- 展开内容（默认隐藏） -->
      <view class="expand-content {{expandState[1] ? 'show' : 'hide'}}">
        <view class="item-row">
          <view class="item-title">企业所得税优惠政策</view>
          <view class="item-image">
            <text class="item-icon">💰</text>
          </view>
        </view>
        <view class="item-row">
          <view class="item-title">增值税减免申请流程</view>
          <view class="item-image">
            <text class="item-icon">📋</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部 TabBar 导航 -->
  <view class="tab-bar">
    <view class="tab-item tab-active">
      <view class="tab-icon">📖</view>
      <view class="tab-text">指引</view>
    </view>
    <view class="tab-item">
      <view class="tab-icon">⚙️</view>
      <view class="tab-text">管理</view>
    </view>
    <view class="tab-item">
      <view class="tab-icon">🔍</view>
      <view class="tab-text">发现</view>
    </view>
    <view class="tab-item">
      <view class="tab-icon">👤</view>
      <view class="tab-text">我的</view>
    </view>
  </view>
</view>
