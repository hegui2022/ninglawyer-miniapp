.index-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background: #1890ff;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.welcome {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar image {
  width: 100%;
  height: 100%;
}

.search-bar {
  padding: 32rpx;
}

.search-input {
  background: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.quick-actions {
  background: #fff;
  margin: 0 32rpx 32rpx;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  justify-content: space-around;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333;
}

.domain-section,
.hot-section,
.session-section {
  background: #fff;
  margin: 0 32rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.domain-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx;
}

.domain-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.domain-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.domain-name {
  font-size: 22rpx;
  color: #666;
}

.hot-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.hot-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #1890ff;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-weight: bold;
}

.hot-item:nth-child(1) .hot-rank {
  background: #ff4d4f;
}

.hot-item:nth-child(2) .hot-rank {
  background: #fa8c16;
}

.hot-item:nth-child(3) .hot-rank {
  background: #ffc53d;
}

.hot-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.session-list {
  white-space: nowrap;
  display: flex;
  gap: 24rpx;
}

.session-card {
  display: inline-block;
  width: 240rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-right: 24rpx;
}

.session-card:last-child {
  margin-right: 0;
}

.session-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.session-time {
  font-size: 20rpx;
  color: #999;
}
