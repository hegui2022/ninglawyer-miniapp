/* pages/contract-detail/contract-detail.wxss */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

.contract-content {
  background: #F9F9F9;
  padding: 30rpx;
  border-radius: 8rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.content-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.review-summary {
  margin-bottom: 30rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-item:last-child {
  margin-bottom: 0;
}

.summary-label {
  font-size: 28rpx;
  color: #666666;
  width: 180rpx;
  flex-shrink: 0;
}

.summary-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.actions .btn {
  flex: 1;
}
