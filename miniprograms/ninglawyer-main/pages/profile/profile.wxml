<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar" bindtap="changeAvatar">
      <image src="{{userInfo.avatar || '/static/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-edit">
        <image src="/static/icons/camera.png"></image>
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || '未设置昵称'}}</text>
      <text class="user-phone">{{userInfo.phone ? userInfo.phone.substring(0, 3) + '****' + userInfo.phone.substring(7) : '未绑定手机'}}</text>
    </view>
    <view class="edit-btn" bindtap="editProfile">
      <image src="/static/icons/edit.png"></image>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goToHistory" data-tab="consultation">
      <text class="stat-value">{{stats.consultation_count}}</text>
      <text class="stat-label">咨询次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goToHistory" data-tab="contract">
      <text class="stat-value">{{stats.contract_count}}</text>
      <text class="stat-label">合同次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="goToHistory" data-tab="desensitize">
      <text class="stat-value">{{stats.desensitize_count}}</text>
      <text class="stat-label">脱敏次数</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <!-- 个人资料 -->
    <view class="menu-item" bindtap="goToProfileDetail">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/user.png"></image>
        <text class="menu-text">个人资料</text>
      </view>
      <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
    </view>

    <!-- 我的档案 -->
    <view class="menu-item" bindtap="goToProfile">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/profile.png"></image>
        <text class="menu-text">我的档案</text>
      </view>
      <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
    </view>

    <!-- 手机号绑定 -->
    <view class="menu-item" bindtap="bindPhone">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/phone.png"></image>
        <text class="menu-text">{{userInfo.phone ? '更换手机号' : '绑定手机号'}}</text>
      </view>
      <view class="menu-right">
        <text class="menu-value">{{userInfo.phone ? userInfo.phone.substring(0, 3) + '****' + userInfo.phone.substring(7) : '未绑定'}}</text>
        <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
      </view>
    </view>

    <view class="menu-divider"></view>

    <!-- 消息通知 -->
    <view class="menu-item" bindtap="goToNotification">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/notification.png"></image>
        <text class="menu-text">消息通知</text>
      </view>
      <view class="menu-right">
        <view class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
        <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
      </view>
    </view>

    <!-- 设置 -->
    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/settings.png"></image>
        <text class="menu-text">设置</text>
      </view>
      <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
    </view>

    <view class="menu-divider"></view>

    <!-- 关于我们 -->
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/about.png"></image>
        <text class="menu-text">关于我们</text>
      </view>
      <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
    </view>

    <!-- 意见反馈 -->
    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/feedback.png"></image>
        <text class="menu-text">意见反馈</text>
      </view>
      <image class="menu-arrow" src="/static/icons/arrow-right.png"></image>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
