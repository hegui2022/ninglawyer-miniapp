/* 合同编辑器组件样式 */
.contract-editor {
  width: 100%;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  height: 100vh;
}

/* 工具栏 */
.editor-toolbar {
  padding: 16rpx 24rpx;
  background-color: #F9F9F9;
  border-bottom: 1rpx solid #E5E5E5;
}

.toolbar-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toolbar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #666666;
  min-width: 80rpx;
  transition: all 0.3s;
}

.toolbar-btn::after {
  border: none;
}

.toolbar-btn:active {
  background-color: #F0F0F0;
  transform: scale(0.95);
}

.btn-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.btn-label {
  font-size: 22rpx;
}

/* 编辑区域 */
.editor-content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.contract-textarea {
  width: 100%;
  min-height: 400rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 编辑器底部 */
.editor-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #F9F9F9;
  border-top: 1rpx solid #E5E5E5;
}

.word-count,
.last-saved {
  font-size: 24rpx;
  color: #999999;
}

/* 快捷模板 */
.quick-templates {
  padding: 24rpx;
  background-color: #F9F9F9;
  border-top: 1rpx solid #E5E5E5;
}

.template-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.template-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.template-item {
  padding: 20rpx;
  background-color: #ffffff;
  border: 1rpx solid #E0E0E0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.template-item:active {
  background-color: #F0F0F0;
  transform: scale(0.95);
}

.template-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.template-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
