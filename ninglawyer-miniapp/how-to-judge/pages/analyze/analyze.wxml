<!-- 怎么判 - 智能分析 -->
<view class="analyze-page">
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">案件类型</text>
      <input class="form-input" placeholder="请输入案件类型" value="{{caseType}}" bindinput="onCaseTypeChange" />
    </view>
    
    <view class="form-item">
      <text class="form-label">案件描述</text>
      <textarea class="form-textarea" placeholder="请详细描述案件情况" value="{{caseDescription}}" bindinput="onDescriptionInput" maxlength="500"></textarea>
    </view>
    
    <view class="form-item">
      <text class="form-label">涉及金额（元）</text>
      <input class="form-input" type="number" placeholder="请输入涉及金额" value="{{amount}}" bindinput="onAmountInput" />
    </view>
    
    <view class="form-item">
      <text class="form-label">相关证据</text>
      <textarea class="form-textarea" placeholder="请列举相关证据" value="{{evidence}}" bindinput="onEvidenceInput"></textarea>
    </view>
  </view>
  
  <button class="btn-submit" bindtap="onAnalyze" disabled="{{analyzing}}">
    {{analyzing ? '分析中...' : '开始分析'}}
  </button>
  
  <!-- 分析结果 -->
  <view class="result-section" wx:if="{{analysisResult}}">
    <view class="result-header">
      <text class="result-title">分析结果</text>
    </view>
    <view class="result-content">
      <text class="result-text">{{analysisResult.analysis}}</text>
    </view>
    <view class="result-actions">
      <button class="btn-save" bindtap="onSave">保存结果</button>
    </view>
  </view>
</view>
