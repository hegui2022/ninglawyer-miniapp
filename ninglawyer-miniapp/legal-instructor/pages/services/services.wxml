<!-- 法律教官 - 服务列表 -->
<view class="services-page">
  <view class="category-tabs">
    <view 
      class="tab-item {{item.id === currentCategory ? 'active' : ''}}" 
      wx:for="{{categories}}" 
      wx:key="id"
      bindtap="onCategoryChange" 
      data-category="{{item.id}}"
    >
      <text class="tab-text">{{item.name}}</text>
    </view>
  </view>
  
  <view class="service-list" wx:if="{{serviceList.length > 0}}">
    <view 
      class="service-item" 
      wx:for="{{serviceList}}" 
      wx:key="id"
      bindtap="onServiceTap" 
      data-id="{{item.id}}"
    >
      <view class="service-icon">{{item.icon || '⚖️'}}</view>
      <view class="service-info">
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.description}}</text>
        <view class="service-meta">
          <text class="service-price">¥{{item.price}}</text>
          <text class="service-category">{{item.categoryName}}</text>
        </view>
      </view>
      <view class="service-arrow">›</view>
    </view>
  </view>
  
  <view class="empty-section" wx:if="{{serviceList.length === 0}}">
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无服务</text>
  </view>
</view>
