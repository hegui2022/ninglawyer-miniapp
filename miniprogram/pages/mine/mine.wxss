/* pages/mine/mine.wxss */

.mine-container {
  min-height: 100vh;
  background: #F7F7F7;
  display: flex;
  flex-direction: column;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  padding: 60px 20px 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: white;
}

.avatar-large {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50px;
  margin-bottom: 16px;
  border: 3px solid rgba(255, 255, 255, 0.3);
}

.user-name {
  font-size: 24px;
  font-weight: 600;
  margin-bottom: 8px;
}

.user-desc {
  font-size: 14px;
  opacity: 0.9;
  text-align: center;
}

/* 统计卡片 */
.stats-card {
  background: white;
  margin: -20px 16px 16px;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 28px;
  font-weight: 600;
  color: #07C160;
  margin-bottom: 4px;
}

.stat-label {
  font-size: 12px;
  color: #999999;
}

.stat-divider {
  width: 1px;
  background: #E5E5E5;
  margin: 0 16px;
}

/* 功能列表 */
.function-list {
  background: white;
  margin: 0 16px 16px;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.function-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #F5F5F5;
  transition: background 0.2s;
}

.function-item:last-child {
  border-bottom: none;
}

.function-item:active {
  background: #F5F5F5;
}

.item-left {
  display: flex;
  align-items: center;
}

.item-icon {
  font-size: 22px;
  margin-right: 12px;
}

.item-title {
  font-size: 15px;
  color: #333333;
}

.item-right {
  display: flex;
  align-items: center;
}

.cache-size {
  font-size: 13px;
  color: #999999;
  margin-right: 8px;
}

.item-arrow {
  font-size: 24px;
  color: #CCCCCC;
  font-weight: 300;
}

/* 免责声明 */
.disclaimer {
  margin: 0 16px 16px;
  padding: 16px;
  background: rgba(255, 193, 7, 0.1);
  border-radius: 12px;
  border: 1px solid rgba(255, 193, 7, 0.3);
}

.disclaimer-text {
  font-size: 12px;
  color: #FFA000;
  line-height: 1.8;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 20px;
  color: #CCCCCC;
  font-size: 12px;
}
