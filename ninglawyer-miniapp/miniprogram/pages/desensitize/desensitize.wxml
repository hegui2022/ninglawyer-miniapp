<!--pages/desensitize/desensitize.wxml-->
<view class="container">
  <view class="page-title">🔒 证据脱敏</view>
  <view class="page-desc">快速脱敏敏感信息，保护隐私</view>

  <!-- 输入表单 -->
  <view class="form-section">
    <view class="form-item">
      <view class="form-label">姓名</view>
      <input
        class="form-input"
        placeholder="请输入姓名"
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">身份证号</view>
      <input
        class="form-input"
        placeholder="请输入身份证号"
        value="{{idCard}}"
        bindinput="onIdCardInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">手机号</view>
      <input
        class="form-input"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        type="number"
      />
    </view>

    <view class="form-item">
      <view class="form-label">地址</view>
      <input
        class="form-input"
        placeholder="请输入地址"
        value="{{address}}"
        bindinput="onAddressInput"
      />
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="button-group">
    <button class="btn btn-default" bindtap="onClear">清空</button>
    <button class="btn btn-primary" bindtap="onDesensitize" loading="{{loading}}">
      {{loading ? '脱敏中...' : '开始脱敏'}}
    </button>
  </view>

  <!-- 结果展示 -->
  <view class="result-section" wx:if="{{result}}">
    <view class="result-title">脱敏结果</view>
    <view class="result-content">
      <view class="result-item" wx:if="{{result.name}}">
        <text class="result-label">姓名：</text>
        <text class="result-value">{{result.name}}</text>
      </view>
      <view class="result-item" wx:if="{{result.id_card}}">
        <text class="result-label">身份证：</text>
        <text class="result-value">{{result.id_card}}</text>
      </view>
      <view class="result-item" wx:if="{{result.phone}}">
        <text class="result-label">手机号：</text>
        <text class="result-value">{{result.phone}}</text>
      </view>
      <view class="result-item" wx:if="{{result.address}}">
        <text class="result-label">地址：</text>
        <text class="result-value">{{result.address}}</text>
      </view>
    </view>
    <button class="btn btn-copy" bindtap="onCopyResult">复制结果</button>
  </view>
</view>
