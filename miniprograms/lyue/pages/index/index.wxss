/* 理约首页样式 */
.index-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 24rpx;
}

/* 概览区块 */
.overview-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-icon {
  font-size: 36rpx;
}

.section-more {
  font-size: 24rpx;
  color: #07C160;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #07C160;
  display: block;
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
}

/* 即将到期区块 */
.expiring-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.expiring-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.expiring-item {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 24rpx;
}

.expiring-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.contract-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}

.days-badge {
  font-size: 22rpx;
  color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.days-badge.urgent {
  background: #F44336;
}

.days-badge.normal {
  background: #FF9800;
}

.expiring-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #666666;
}

.info-date {
  font-size: 22rpx;
  color: #999999;
}

/* 最近活动区块 */
.activity-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.activity-icon {
  width: 80rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.icon-emoji {
  font-size: 36rpx;
}

.activity-content {
  flex: 1;
  min-width: 0;
}

.activity-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.activity-desc {
  font-size: 22rpx;
  color: #999999;
}

.activity-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-status {
  font-size: 20rpx;
  color: #666666;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.activity-status.pending {
  background: #FFF3E0;
  color: #FF9800;
}

.activity-status.completed {
  background: #E8F5E9;
  color: #07C160;
}

.activity-time {
  font-size: 20rpx;
  color: #999999;
}

/* 快捷入口 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.action-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  font-size: 48rpx;
}

.action-label {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
}
