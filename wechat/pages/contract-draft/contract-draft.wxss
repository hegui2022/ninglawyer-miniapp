/* pages/contract-draft/contract-draft.wxss */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  background: #FFFFFF;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #E8E8E8;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  transition: all 0.3s;
}

.step-item.active .step-number {
  background: #4A90E2;
  color: #FFFFFF;
}

.step-text {
  font-size: 22rpx;
  color: #999999;
  transition: all 0.3s;
}

.step-item.active .step-text {
  color: #4A90E2;
  font-weight: bold;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: #E8E8E8;
  margin: 0 10rpx 40rpx 10rpx;
}

.step-content {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
}

.contract-types {
  margin-top: 20rpx;
}

.type-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.type-card:active {
  background: #F0F0F0;
  transform: scale(0.98);
}

.type-card:last-child {
  margin-bottom: 0;
}

.type-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.type-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.type-desc {
  flex: 1;
  font-size: 24rpx;
  color: #999999;
}

.type-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  margin-left: 20rpx;
}

.form-section {
  margin-top: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.required {
  color: #FF5A5F;
  margin-left: 4rpx;
}

.form-input {
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
  height: 300rpx;
}

.preview-content {
  background: #F9F9F9;
  border-radius: 8rpx;
  padding: 30rpx;
  max-height: 800rpx;
  overflow-y: auto;
  margin-bottom: 30rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.actions .btn {
  flex: 1;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}
