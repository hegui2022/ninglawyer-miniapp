/**app.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  box-sizing: border-box;
}

/* 通用样式 */
.btn-primary {
  background-color: #3cc51f;
  color: #fff;
  border-radius: 8rpx;
}

.btn-default {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.input-field {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  margin: 10rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
}

.text-primary {
  color: #3cc51f;
}

.text-secondary {
  color: #999;
  font-size: 24rpx;
}
