<!--pages/discover/discover.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="发现" showBack="{{false}}"></nav-bar>

  <!-- 功能入口列表 -->
  <view class="function-list">
    <!-- 行业监管动态 -->
    <view class="function-item" bindtap="goToFunction" data-type="regulation">
      <view class="function-icon regulation">
        <text class="icon-text">i</text>
      </view>
      <view class="function-info">
        <text class="function-name">行业监管动态</text>
        <view class="function-extra">
          <view class="function-thumb">
            <text>📰</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 合规培训 -->
    <view class="function-item" bindtap="goToFunction" data-type="training">
      <view class="function-icon training">
        <text class="icon-icon">👥</text>
      </view>
      <view class="function-info">
        <text class="function-name">合规培训</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 消息 -->
    <view class="function-item" bindtap="goToFunction" data-type="message">
      <view class="function-icon message">
        <text class="icon-icon">💬</text>
      </view>
      <view class="function-info">
        <text class="function-name">消息</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 合同场景师 -->
    <view class="function-item" bindtap="goToFunction" data-type="contract">
      <view class="function-icon contract">
        <text class="icon-icon">👥</text>
      </view>
      <view class="function-info">
        <text class="function-name">合同场景师</text>
      </view>
    </view>
  </view>

  <!-- TabBar 组件 -->
  <tab-bar currentPath="/pages/discover/discover"></tab-bar>
</view>
