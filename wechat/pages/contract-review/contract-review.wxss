/* pages/contract-review/contract-review.wxss */
.summary-card {
  display: flex;
  align-items: center;
  padding: 40rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.summary-high {
  background: linear-gradient(135deg, #FF5A5F 0%, #FF8A84 100%);
}

.summary-medium {
  background: linear-gradient(135deg, #FAAD14 0%, #FFD666 100%);
}

.summary-low {
  background: linear-gradient(135deg, #52C41A 0%, #95DE64 100%);
}

.summary-icon {
  font-size: 80rpx;
  margin-right: 30rpx;
}

.summary-text {
  flex: 1;
  color: #FFFFFF;
}

.summary-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.summary-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.risk-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEEEEE;
}

.risk-section {
  margin-bottom: 40rpx;
}

.risk-section:last-child {
  margin-bottom: 0;
}

.risk-section-title {
  font-size: 28rpx;
  font-weight: bold;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.risk-item {
  background: #F9F9F9;
  padding: 30rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.risk-item:last-child {
  margin-bottom: 0;
}

.risk-item-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.risk-item-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.risk-item-suggestion {
  font-size: 24rpx;
  color: #4A90E2;
  line-height: 1.6;
  background: #E6F7FF;
  padding: 16rpx;
  border-radius: 4rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.actions .btn {
  flex: 1;
}
