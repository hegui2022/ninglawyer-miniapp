/* 合同履约页面样式 */
.contract-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 24rpx;
}

/* 合同头部 */
.contract-header {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.contract-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.contract-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #666666;
}

/* 履约进度 */
.progress-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.section-value {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
}

.section-count {
  font-size: 22rpx;
  color: #999999;
}

.section-action {
  font-size: 24rpx;
  color: #07C160;
}

.progress-bar {
  height: 16rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 24rpx;
  color: #666666;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: 700;
  color: #07C160;
}

/* 通用区块 */
.section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

/* 里程碑列表 */
.milestone-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.milestone-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.milestone-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.milestone-icon.completed {
  background: #E8F5E9;
}

.milestone-icon.pending {
  background: #F5F5F5;
}

.icon-text {
  font-size: 24rpx;
  color: #07C160;
}

.milestone-content {
  flex: 1;
  min-width: 0;
}

.milestone-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.milestone-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.milestone-date {
  font-size: 22rpx;
  color: #07C160;
}

.milestone-status {
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* 提醒列表 */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.reminder-icon {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-emoji {
  font-size: 32rpx;
}

.reminder-content {
  flex: 1;
  min-width: 0;
}

.reminder-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.reminder-schedule {
  font-size: 22rpx;
  color: #666666;
  display: block;
}

.reminder-next {
  font-size: 20rpx;
  color: #07C160;
  display: block;
}

.reminder-status {
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 履约记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.record-icon {
  width: 56rpx;
  height: 56rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-content {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.record-date {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.record-amount {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
  display: block;
}

.record-status {
  flex-shrink: 0;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
