/* 判例详情页面样式 */
.case-detail-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

.case-header {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.case-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.case-court,
.case-no {
  font-size: 24rpx;
  color: #666666;
}

.case-date {
  font-size: 22rpx;
  color: #999999;
}

.case-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.section-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.party-info {
  font-size: 26rpx;
  color: #333333;
  line-height: 2;
  margin-bottom: 12rpx;
}

.party-label {
  color: #999999;
  font-weight: 600;
  margin-right: 8rpx;
}

.party-value {
  color: #333333;
}

.result-box {
  background: #E8F5E9;
  border-radius: 12rpx;
  padding: 24rpx;
}

.result-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #07C160;
  display: block;
  margin-bottom: 12rpx;
}

.result-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #F44336;
}

.law-text {
  font-size: 26rpx;
  color: #07C160;
  font-weight: 600;
}
