<view class="upload-container">
  <!-- 上传区域 -->
  <view class="upload-area" bindtap="chooseFile">
    <image class="upload-icon" src="/static/icons/upload.png"></image>
    <text class="upload-text">点击或拖拽文件到此处上传</text>
    <text class="upload-hint">支持 PDF、Word、图片格式，最大 10MB</text>
  </view>

  <!-- 文件列表 -->
  <view class="file-list" wx:if="{{files.length > 0}}">
    <view class="file-item" wx:for="{{files}}" wx:key="id">
      <image class="file-icon" src="/static/icons/file.png"></image>
      <view class="file-info">
        <text class="file-name">{{item.name}}</text>
        <text class="file-size">{{item.size}}</text>
      </view>
      <view class="file-status">
        <text wx:if="{{item.status === 'uploading'}}">上传中...</text>
        <text wx:elif="{{item.status === 'success'}}">✓</text>
        <text wx:elif="{{item.status === 'error'}}">✗</text>
      </view>
    </view>
  </view>
</view>
