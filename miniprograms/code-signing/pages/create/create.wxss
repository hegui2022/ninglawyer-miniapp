/* 码上签约 - 创建合同样式 */
.create-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

.page-header {
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #999999;
  display: block;
}

.template-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.template-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #EBEDF0;
}

.template-item:last-child {
  border-bottom: none;
}

.template-icon {
  width: 80rpx;
  height: 80rpx;
  background: #07C160;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.icon-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.template-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.template-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.template-desc {
  font-size: 24rpx;
  color: #999999;
}

.template-arrow {
  width: 32rpx;
  height: 32rpx;
}

.custom-contract {
  margin-top: 24rpx;
  padding: 48rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #07C160;
}

.custom-icon {
  font-size: 64rpx;
  color: #07C160;
  margin-bottom: 16rpx;
}

.custom-text {
  font-size: 28rpx;
  color: #07C160;
}
