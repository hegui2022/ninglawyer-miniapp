<!--pages/manage/manage.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="管理" showBack="{{false}}"></nav-bar>

  <!-- 部门快捷入口区 -->
  <view class="department-section">
    <scroll-view scroll-x="{{true}}" class="department-scroll" show-scrollbar="{{false}}">
      <view class="department-list">
        <!-- 股东会 -->
        <view class="department-card" bindtap="goToDepartment" data-dept="shareholders">
          <view class="department-icon shareholders">
            <text class="icon-text">🏢</text>
          </view>
          <text class="department-name">股东会</text>
        </view>

        <!-- 销售部 -->
        <view class="department-card" bindtap="goToDepartment" data-dept="sales">
          <view class="department-icon sales">
            <text class="icon-text">💼</text>
          </view>
          <text class="department-name">销售部</text>
        </view>

        <!-- 财务部 -->
        <view class="department-card" bindtap="goToDepartment" data-dept="finance">
          <view class="department-icon finance">
            <text class="icon-text">💰</text>
          </view>
          <text class="department-name">财务部</text>
        </view>

        <!-- 人事部 -->
        <view class="department-card" bindtap="goToDepartment" data-dept="hr">
          <view class="department-icon hr">
            <text class="icon-text">👥</text>
          </view>
          <text class="department-name">人事部</text>
        </view>

        <!-- 技术部 -->
        <view class="department-card" bindtap="goToDepartment" data-dept="tech">
          <view class="department-icon tech">
            <text class="icon-text">💻</text>
          </view>
          <text class="department-name">技术部</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 重要通知区 -->
  <view class="notice-section" bindtap="goToNoticeDetail">
    <view class="notice-left">
      <view class="notice-icon">
        <text>📢</text>
      </view>
      <text class="notice-title">股东会通知</text>
    </view>
    <view class="notice-countdown">
      <text class="countdown-text">距离会议召开 {{countdown}}</text>
    </view>
  </view>

  <!-- 审批项目列表区 -->
  <view class="approval-section">
    <view class="section-title">项目</view>

    <view class="approval-list">
      <!-- 事假申请 -->
      <view class="approval-item" bindtap="goToApproval" data-type="leave">
        <view class="approval-icon leave">
          <text>📝</text>
        </view>
        <view class="approval-info">
          <text class="approval-name">事假申请</text>
        </view>
        <view class="approval-status pending">
          <text>审批中</text>
        </view>
      </view>

      <!-- 差旅费报销申请 -->
      <view class="approval-item" bindtap="goToApproval" data-type="expense">
        <view class="approval-icon expense">
          <text>✈️</text>
        </view>
        <view class="approval-info">
          <text class="approval-name">差旅费报销申请</text>
        </view>
        <view class="approval-status pending">
          <text>审批中</text>
        </view>
      </view>

      <!-- 采购申请 -->
      <view class="approval-item" bindtap="goToApproval" data-type="purchase">
        <view class="approval-icon purchase">
          <text>🛒</text>
        </view>
        <view class="approval-info">
          <text class="approval-name">办公设备采购申请</text>
        </view>
        <view class="approval-status approved">
          <text>已通过</text>
        </view>
      </view>

      <!-- 报销申请 -->
      <view class="approval-item" bindtap="goToApproval" data-type="reimburse">
        <view class="approval-icon reimburse">
          <text>🧾</text>
        </view>
        <view class="approval-info">
          <text class="approval-name">日常报销申请</text>
        </view>
        <view class="approval-status rejected">
          <text>已拒绝</text>
        </view>
      </view>
    </view>
  </view>

  <!-- TabBar 组件 -->
  <tab-bar currentPath="/pages/manage/manage"></tab-bar>
</view>
