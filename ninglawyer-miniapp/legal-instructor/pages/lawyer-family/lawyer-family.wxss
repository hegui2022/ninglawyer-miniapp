/* 法律教官 - 宁律师家族样式 */
.lawyer-family-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 32rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: linear-gradient(135deg, #07C160 0%, #06A852 100%);
  padding: 48rpx 32rpx;
  color: #ffffff;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

/* 搜索框 */
.search-box {
  margin: 24rpx;
  position: relative;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 0 80rpx 0 32rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
}

/* 律师列表 */
.lawyer-list {
  padding: 0 24rpx;
}

.lawyer-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.lawyer-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.lawyer-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.lawyer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.lawyer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.lawyer-rating {
  display: flex;
  align-items: center;
}

.star-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #FF9500;
  font-weight: 600;
}

.lawyer-domain {
  font-size: 24rpx;
  color: #07C160;
  margin-bottom: 8rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #E8F8F0;
  border-radius: 8rpx;
}

.lawyer-desc {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.lawyer-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lawyer-count {
  font-size: 24rpx;
  color: #999999;
}

.btn-consult {
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
