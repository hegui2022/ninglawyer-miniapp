# 宁律师法律咨询小程序 - 环境配置文件
# 复制此文件为 .env 并填写实际值

# ========================================
# API 配置
# ========================================
API_HOST=0.0.0.0
API_PORT=5000
API_PREFIX=/api
DEBUG=False

# ========================================
# 数据库配置 (PostgreSQL)
# ========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ninglawyer
DB_USER=postgres
DB_PASSWORD=your_secure_password_here  # ⚠️ 请修改为强密码

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # 留空表示无密码

# ========================================
# Milvus 配置 (向量数据库)
# ========================================
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=law_knowledge

# ========================================
# Neo4j 配置 (图数据库，可选)
# ========================================
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here  # ⚠️ 请修改为强密码

# ========================================
# 对象存储配置 (S3 兼容)
# ========================================
S3_ENDPOINT=your_s3_endpoint_here
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=ninglawyer

# ========================================
# JWT 配置
# ========================================
JWT_SECRET_KEY=your_jwt_secret_key_here  # ⚠️ 请修改为随机字符串
JWT_ACCESS_TOKEN_EXPIRES=3600  # Token 过期时间（秒）

# ========================================
# 豆包 AI 配置 (必须配置)
# ========================================
# 获取方式：访问 https://console.volcengine.com/ark/
DOUBAO_API_KEY=your_doubao_api_key_here  # ⚠️ 必须配置
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=doubao-seed-1-6-251015  # 可选，默认为 doubao-seed-1-6-251015

# ========================================
# 知识库配置
# ========================================
KNOWLEDGE_BASE_ENDPOINT=your_knowledge_base_endpoint_here

# ========================================
# 语音服务配置 (可选)
# ========================================
VOICE_ACCESS_KEY=your_voice_access_key_here
VOICE_SECRET_KEY=your_voice_secret_key_here
VOICE_BASE_URL=your_voice_base_url_here

# ========================================
# 微信小程序配置
# ========================================
# 获取方式：登录 https://mp.weixin.qq.com/
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=/app/work/logs/bypass

# ========================================
# MinIO 配置 (用于 Milvus)
# ========================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ========================================
# 其他配置
# ========================================
# 文件上传大小限制 (MB)
MAX_UPLOAD_SIZE=50

# 会话超时时间 (秒)
SESSION_TIMEOUT=3600

# 并发工作进程数
WORKERS=4
