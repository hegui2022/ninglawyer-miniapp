/* pages/history/history.wxss */

.history-container {
  min-height: 100vh;
  background: #F7F7F7;
  display: flex;
  flex-direction: column;
}

.history-list {
  flex: 1;
  padding: 16px 12px;
  padding-bottom: 100px;
}

.message-row {
  display: flex;
  margin-bottom: 20px;
}

.message-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.avatar.lawyer {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
}

.avatar.user {
  background: linear-gradient(135deg, #07C160 0%, #06A653 100%);
}

.message-content {
  max-width: 75%;
  margin: 0 12px;
}

.message-row.user .message-content {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.message-row.lawyer .message-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.message-bubble {
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 14px;
  line-height: 1.6;
  word-wrap: break-word;
}

.message-bubble.user {
  background: linear-gradient(135deg, #07C160 0%, #06A653 100%);
  color: white;
  border-bottom-right-radius: 4px;
}

.message-bubble.lawyer {
  background: white;
  color: #333333;
  border-bottom-left-radius: 4px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.audio-player {
  margin-top: 8px;
  display: flex;
  align-items: center;
  padding: 6px 10px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 8px;
  border: 1px solid #E5E5E5;
}

.audio-icon {
  width: 28px;
  height: 28px;
}

.audio-duration {
  font-size: 11px;
  color: #999999;
  margin-left: 6px;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100px 20px;
}

.empty-icon {
  font-size: 80px;
  margin-bottom: 20px;
  opacity: 0.5;
}

.empty-text {
  font-size: 16px;
  color: #333333;
  margin-bottom: 8px;
}

.empty-tip {
  font-size: 13px;
  color: #999999;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  border-top: 1px solid #E5E5E5;
}

.action-btn {
  flex: 1;
  margin: 0 8px;
  padding: 12px;
  background: #F5F5F5;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #666666;
  transition: all 0.2s;
}

.action-btn:active {
  background: #E5E5E5;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 20px;
  margin-right: 8px;
}

.btn-text {
  font-size: 14px;
  font-weight: 500;
}
