<!--pages/contract-list/contract-list.wxml-->
<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active' : ''}}" bindtap="setFilter('all')">
      全部
    </view>
    <view class="filter-item {{filterType === 'draft' ? 'active' : ''}}" bindtap="setFilter('draft')">
      草稿
    </view>
    <view class="filter-item {{filterType === 'signed' ? 'active' : ''}}" bindtap="setFilter('signed')">
      已签署
    </view>
    <view class="filter-item" bindtap="goToTemplates">
      📋 模板库
    </view>
  </view>

  <!-- 合同列表 -->
  <view class="contract-list" wx:if="{{contracts.length > 0}}">
    <view class="contract-item" wx:for="{{contracts}}" wx:key="id" bindtap="goToDetail(item.id)">
      <view class="contract-header">
        <view class="contract-title">{{item.contract_name}}</view>
        <view class="tag tag-{{item.status === 'signed' ? 'success' : 'primary'}}">
          {{item.status === 'signed' ? '已签署' : '草稿'}}
        </view>
      </view>

      <view class="contract-info">
        <view class="info-row">
          <text class="info-label">类型：</text>
          <text class="info-value">{{item.contract_type_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">用人单位：</text>
          <text class="info-value">{{item.employer_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">劳动者：</text>
          <text class="info-value">{{item.employee_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">创建时间：</text>
          <text class="info-value">{{item.created_at}}</text>
        </view>
      </view>

      <!-- 审查状态 -->
      <view class="review-status" wx:if="{{item.has_review}}">
        <text class="review-icon">📋</text>
        <text class="review-text" wx:if="{{item.overall_risk === '高风险'}}" style="color: #F5222D;">
          风险等级：{{item.overall_risk}}
        </text>
        <text class="review-text" wx:elif="{{item.overall_risk === '中风险'}}" style="color: #FAAD14;">
          风险等级：{{item.overall_risk}}
        </text>
        <text class="review-text" wx:else style="color: #52C41A;">
          风险等级：{{item.overall_risk}}
        </text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无合同记录</text>
    <view class="btn btn-secondary" bindtap="goToDraft">去起草合同</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
