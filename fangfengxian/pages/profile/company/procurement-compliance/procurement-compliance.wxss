/* pages/profile/company/procurement-compliance/procurement-compliance.wxss */
.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 80rpx;
}

/* ==================== 采购风险识别模块 ==================== */
.search-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  transition: all 0.3s ease;
}

.search-section:active {
  background-color: #F8F8F8;
}

.search-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.search-text {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

/* ==================== 模块通用样式 ==================== */
.module-section {
  padding: 0 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: bold;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.item-list {
  padding-top: 8rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  position: relative;
  transition: all 0.3s ease;
}

.item:active {
  background-color: #F8F8F8;
}

.item:last-child {
  border-bottom: none;
}

.item.active {
  background-color: #E3F2FD;
}

.item-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
}

.item-icon {
  font-size: 24rpx;
  color: #2196F3;
  margin-right: 12rpx;
}

.item-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 蓝色高亮条 */
.active-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #2196F3;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background-color: #E5E5E5;
  margin: 0;
}
