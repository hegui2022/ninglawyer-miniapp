<!--pages/shareholders/shareholders.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="股东会" showBack="{{true}}" bind:back="goBack"></nav-bar>

  <!-- 会议状态 -->
  <view class="meeting-status">
    <text class="status-text">股东会进行中。。。</text>
  </view>

  <!-- 会议类型切换 -->
  <view class="meeting-tabs">
    <view class="tab-item {{meetingType === 'temporary' ? 'active' : ''}}" bindtap="switchMeetingType" data-type="temporary">
      <text class="tab-icon">🎧</text>
      <text class="tab-text">临时会议</text>
    </view>
    <view class="tab-item {{meetingType === 'regular' ? 'active' : ''}}" bindtap="switchMeetingType" data-type="regular">
      <text class="tab-icon">📅</text>
      <text class="tab-text">定期会议</text>
    </view>
  </view>

  <!-- 召集会议模块 -->
  <view class="module-section">
    <view class="module-header">
      <text class="module-icon">🔔</text>
      <text class="module-title">召集会议</text>
    </view>

    <view class="module-content">
      <!-- 召集人信息 -->
      <view class="info-row">
        <text class="info-label">召集人</text>
        <text class="info-divider">持股 15% 的股东</text>
        <text class="info-link" bindtap="viewShareholderDetail">张三</text>
      </view>

      <!-- 会议通知书 -->
      <view class="notice-row">
        <text class="notice-label">会议通知书</text>
        <text class="notice-link" bindtap="viewNoticeDetail">详情</text>
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider"></view>

  <!-- 主持会议模块 -->
  <view class="module-section">
    <view class="module-header">
      <text class="module-icon">🎤</text>
      <text class="module-title">主持会议</text>
    </view>

    <view class="module-content">
      <!-- 会议方式选项 -->
      <view class="meeting-options">
        <view class="option-item {{meetingMethod === 'phone' ? 'active' : ''}}" bindtap="selectMeetingMethod" data-method="phone">
          <text class="option-icon">📞</text>
          <text class="option-text">电话语音</text>
          <text wx:if="{{meetingMethod === 'phone'}}" class="option-check">✓</text>
        </view>
        <view class="option-item {{meetingMethod === 'video' ? 'active' : ''}}" bindtap="selectMeetingMethod" data-method="video">
          <text class="option-icon">📹</text>
          <text class="option-text">视频会</text>
          <text wx:if="{{meetingMethod === 'video'}}" class="option-check">✓</text>
        </view>
      </view>

      <!-- 会议记录入口 -->
      <view class="meeting-record" bindtap="viewMeetingRecord">
        <text class="record-icon">📋</text>
        <text class="record-text">会议记录</text>
        <text class="record-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider"></view>

  <!-- 会议表决模块 -->
  <view class="module-section">
    <view class="module-header">
      <text class="module-icon">💬</text>
      <text class="module-title">会议表决</text>
    </view>

    <view class="module-content">
      <view class="vote-action" bindtap="goToVote">
        <text class="vote-icon">🗳️</text>
        <text class="vote-text">进入投票</text>
        <text class="vote-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- TabBar 组件 -->
  <tab-bar currentPath="/pages/shareholders/shareholders"></tab-bar>
</view>
