/* 理约 - 合同详情样式 */
.detail-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.header-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.contract-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.contract-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.info-section,
.content-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E0E0E0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.content-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  white-space: pre-wrap;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #E0E0E0;
  display: flex;
  gap: 16rpx;
}

.btn-edit,
.btn-delete {
  flex: 1;
  height: 88rpx;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-edit {
  background: #07C160;
  color: #ffffff;
}

.btn-delete {
  background: #ffffff;
  color: #F44336;
  border: 2rpx solid #F44336;
}
