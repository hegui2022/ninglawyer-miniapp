<!--pages/history/history.wxml-->
<view class="history-container">
  <!-- 历史记录列表 -->
  <view class="history-list">
    <block wx:if="{{messages.length > 0}}">
      <view class="history-item" wx:for="{{messages}}" wx:key="id">
        <!-- 用户消息 -->
        <view class="message-row user" wx:if="{{item.role === 'user'}}">
          <view class="avatar user">👤</view>
          <view class="message-content">
            <view class="message-bubble user">
              {{item.content}}
            </view>
          </view>
        </view>
        
        <!-- 律师消息 -->
        <view class="message-row lawyer" wx:if="{{item.role === 'lawyer'}}">
          <view class="avatar lawyer">👨‍⚖️</view>
          <view class="message-content">
            <view class="message-bubble lawyer">
              {{item.content}}
            </view>
            <view class="audio-player" wx:if="{{item.audioUrl}}" bindtap="playAudio" data-url="{{item.audioUrl}}">
              <image class="audio-icon" src="{{isPlayingAudio ? '/images/audio-playing.gif' : '/images/audio-static.png'}}" mode="aspectFit"></image>
              <text class="audio-duration">语音</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{messages.length === 0}}">
      <view class="empty-icon">💬</view>
      <view class="empty-text">暂无历史记录</view>
      <view class="empty-tip">开始和宁律师对话吧</view>
    </view>
  </view>
  
  <!-- 底部操作按钮 -->
  <view class="bottom-actions" wx:if="{{messages.length > 0}}">
    <view class="action-btn" bindtap="clearHistory">
      <text class="btn-icon">🗑️</text>
      <text class="btn-text">清空历史</text>
    </view>
    <view class="action-btn" bindtap="exportHistory">
      <text class="btn-icon">📥</text>
      <text class="btn-text">导出记录</text>
    </view>
  </view>
</view>
