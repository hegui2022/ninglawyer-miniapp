.session-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.chat-container { flex: 1; padding: 24rpx; }

.message-list { display: flex; flex-direction: column; gap: 24rpx; }

.message-item { display: flex; gap: 16rpx; }
.message-item.user { flex-direction: row-reverse; }

.message-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }

.message-content { max-width: 70%; padding: 20rpx 24rpx; border-radius: 16rpx; }
.message-content.user { background: #1890ff; color: #fff; }
.message-content.assistant { background: #fff; }

.message-text { font-size: 28rpx; line-height: 1.6; }
.message-time { display: block; font-size: 20rpx; opacity: 0.6; margin-top: 8rpx; }

.input-section { background: #fff; padding: 24rpx; border-top: 1rpx solid #e8e8e8; }

.input-container { display: flex; gap: 16rpx; align-items: flex-end; }

.input-field { flex: 1; background: #f8f9fa; border-radius: 16rpx; padding: 16rpx; font-size: 28rpx; min-height: 80rpx; }

.send-btn { height: 80rpx; padding: 0 32rpx; background: #1890ff; color: #fff; border-radius: 40rpx; font-size: 28rpx; }
.send-btn[disabled] { background: #bfbfbf; }

.typing-indicator { display: flex; gap: 8rpx; padding: 8rpx 0; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #999; animation: typing 1.4s infinite; }
.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-8rpx); } }
