/* 数据统计页面样式 */
.statistics-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 时间范围 */
.time-range {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.time-label {
  font-size: 28rpx;
  color: #333333;
}

.time-value {
  font-size: 28rpx;
  color: #07C160;
  font-weight: 600;
}

/* 概览卡片 */
.overview-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.overview-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.overview-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #07C160;
  display: block;
  margin-bottom: 12rpx;
}

.overview-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.overview-icon {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 64rpx;
  opacity: 0.1;
}

/* 通用区块 */
.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 咨询分类统计 */
.stat-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-info {
  width: 200rpx;
  flex-shrink: 0;
}

.stat-name {
  font-size: 26rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.stat-count {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.stat-bar {
  flex: 1;
  height: 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 24rpx;
}

.bar-fill {
  height: 100%;
  background: #07C160;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.stat-percentage {
  font-size: 22rpx;
  color: #07C160;
  font-weight: 600;
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 合同状态统计 */
.contract-stats {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.contract-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.contract-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.contract-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.contract-count {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 月度趋势图表 */
.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding: 32rpx 0;
  background: #F5F5F5;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.chart-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.chart-bars {
  display: flex;
  gap: 8rpx;
  height: 200rpx;
  align-items: flex-end;
}

.bar {
  width: 32rpx;
  border-radius: 4rpx 4rpx 0 0;
  transition: height 0.3s;
}

.consult-bar {
  background: #07C160;
}

.contract-bar {
  background: #2196F3;
}

.chart-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 图例 */
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.legend-dot.consult-dot {
  background: #07C160;
}

.legend-dot.contract-dot {
  background: #2196F3;
}

.legend-label {
  font-size: 24rpx;
  color: #666666;
}
