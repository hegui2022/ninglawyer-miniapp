/* 怎么判 - 智能分析样式 */
.analyze-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.form-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.btn-submit[disabled] {
  opacity: 0.6;
}

.result-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.result-header {
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.result-content {
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.result-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.btn-save {
  flex: 1;
  height: 80rpx;
  background: #ffffff;
  color: #07C160;
  border: 2rpx solid #07C160;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}
