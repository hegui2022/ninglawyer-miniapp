<!-- 判例查询页面 -->
<view class="cases-page">
  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="搜索案例关键词" 
      value="{{keyword}}" 
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>
  
  <view class="case-list" wx:if="{{filteredCases.length > 0}}">
    <view 
      class="case-card" 
      wx:for="{{filteredCases}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCaseTap"
    >
      <text class="case-title">{{item.title}}</text>
      <view class="case-meta">
        <text class="case-court">{{item.court}}</text>
        <text class="case-no">{{item.caseNo}}</text>
      </view>
      <view class="case-result">
        <text class="result-label">判决结果：</text>
        <text class="result-value">{{item.result}}</text>
      </view>
      <view class="case-tags">
        <text 
          class="tag-item" 
          wx:for="{{item.tags}}" 
          wx:for-item="tag"
          wx:key="*this"
          data-tag="{{tag}}"
          bindtap="onTagTap"
        >
          {{tag}}
        </text>
      </view>
      <text class="case-date">{{item.date}}</text>
    </view>
  </view>
  
  <view class="empty-state" wx:if="{{filteredCases.length === 0}}">
    <text class="empty-icon">📚</text>
    <text class="empty-text">未找到相关案例</text>
    <text class="empty-tip">请尝试其他关键词</text>
  </view>
</view>
