# 环境变量配置

# API 配置
API_HOST=localhost
API_PORT=8080
API_DEBUG=True

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ninglawyer
DB_USER=postgres
DB_PASSWORD=your_password

# 向量数据库配置
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=19530
VECTOR_DB_NAME=ninglawyer_kb

# 图数据库配置
GRAPH_DB_HOST=localhost
GRAPH_DB_PORT=7687
GRAPH_DB_USER=neo4j
GRAPH_DB_PASSWORD=your_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 对象存储配置
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=ninglawyer

# 模型配置
MODEL_API_KEY=your_model_api_key
MODEL_BASE_URL=https://api.example.com
MODEL_NAME=doubao-seed-1-6-251015
MODEL_TEMPERATURE=0.7

# 语音服务配置
VOICE_API_KEY=your_voice_api_key
VOICE_BASE_URL=https://voice-api.example.com

# 小程序配置
MINIPROGRAM_APPID=your_appid
MINIPROGRAM_SECRET=your_secret

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/work/logs/bypass/app.log
