/* pages/template-detail/template-detail.wxss */

.header {
  padding: 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  color: #FFFFFF;
}

.icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.title-group {
  margin-bottom: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.type {
  font-size: 24rpx;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  display: inline-block;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.description {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

.content-group {
  margin-bottom: 30rpx;
}

.content-group:last-child {
  margin-bottom: 0;
}

.content-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.content-value {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  padding-left: 20rpx;
}

.content-value text {
  display: block;
  margin-bottom: 8rpx;
}

.content-value text:last-child {
  margin-bottom: 0;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
