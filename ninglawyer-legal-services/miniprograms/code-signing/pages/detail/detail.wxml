<!-- 合同详情页面 -->
<view class="detail-page" wx:if="{{contract}}">
  <!-- 头部信息 -->
  <view class="detail-header">
    <text class="detail-title">{{contract.title}}</text>
    <view class="detail-meta">
      <view class="status-badge" style="background: {{onStatusColor(contract.status)}};">
        {{onStatusText(contract.status)}}
      </view>
      <text class="create-time">{{contract.createdAt}}</text>
    </view>
  </view>
  
  <!-- 合同内容 -->
  <view class="detail-content">
    <view class="content-section">
      <view class="section-title">合同双方</view>
      <view class="party-card">
        <text class="party-tag">甲方</text>
        <view class="party-info">
          <text class="party-name">{{contract.partyA.name}}</text>
          <text class="party-detail" wx:if="{{contract.partyA.address}}">📍 {{contract.partyA.address}}</text>
          <text class="party-detail" wx:if="{{contract.partyA.contact}}">👤 {{contract.partyA.contact}}</text>
          <text class="party-detail" wx:if="{{contract.partyA.phone}}">📞 {{contract.partyA.phone}}</text>
        </view>
      </view>
      <view class="party-card">
        <text class="party-tag">乙方</text>
        <view class="party-info">
          <text class="party-name">{{contract.partyB.name}}</text>
          <text class="party-detail">🆔 {{contract.partyB.idCard}}</text>
          <text class="party-detail" wx:if="{{contract.partyB.phone}}">📞 {{contract.partyB.phone}}</text>
          <text class="party-detail" wx:if="{{contract.partyB.address}}">📍 {{contract.partyB.address}}</text>
        </view>
      </view>
    </view>
    
    <view class="content-section">
      <view class="section-title">合同期限</view>
      <view class="info-grid">
        <view class="grid-item">
          <text class="item-label">合同类型</text>
          <text class="item-value">{{contract.contractTerm.type === 'fixed' ? '固定期限' : contract.contractTerm.type === 'indefinite' ? '无固定期限' : '以完成一定工作任务为期限'}}</text>
        </view>
        <view class="grid-item" wx:if="{{contract.contractTerm.startDate}}">
          <text class="item-label">开始日期</text>
          <text class="item-value">{{contract.contractTerm.startDate}}</text>
        </view>
        <view class="grid-item" wx:if="{{contract.contractTerm.endDate}}">
          <text class="item-label">结束日期</text>
          <text class="item-value">{{contract.contractTerm.endDate}}</text>
        </view>
      </view>
    </view>
    
    <view class="content-section">
      <view class="section-title">薪资待遇</view>
      <view class="info-grid">
        <view class="grid-item">
          <text class="item-label">薪资金额</text>
          <text class="item-value highlight">{{contract.salary.amount}} 元</text>
        </view>
        <view class="grid-item">
          <text class="item-label">计薪方式</text>
          <text class="item-value">{{contract.salary.payMethod === 'month' ? '月薪' : contract.salary.payMethod === 'day' ? '日薪' : '项目制'}}</text>
        </view>
        <view class="grid-item" wx:if="{{contract.salary.payMethod === 'month'}}">
          <text class="item-label">发放日期</text>
          <text class="item-value">每月{{contract.salary.payDate}}日</text>
        </view>
      </view>
    </view>
    
    <view class="content-section">
      <view class="section-title">工作信息</view>
      <view class="text-block">
        <text class="text-label">工作内容</text>
        <text class="text-content">{{contract.workContent}}</text>
      </view>
      <view class="text-block">
        <text class="text-label">工作地点</text>
        <text class="text-content">{{contract.workPlace}}</text>
      </view>
      <view class="text-block">
        <text class="text-label">工作时间</text>
        <text class="text-content">{{contract.workingHours === 'standard' ? '标准工时制' : contract.workingHours === 'flexible' ? '不定时工作制' : '综合计算工时工作制'}}</text>
      </view>
    </view>
    
    <view class="content-section">
      <view class="section-title">其他条款</view>
      <view class="info-row">
        <text class="row-label">缴纳社保</text>
        <text class="row-value">{{contract.socialInsurance ? '是' : '否'}}</text>
      </view>
      <view class="text-block" wx:if="{{contract.otherTerms}}">
        <text class="text-label">补充条款</text>
        <text class="text-content">{{contract.otherTerms}}</text>
      </view>
    </view>
    
    <!-- 签署信息 -->
    <view class="content-section" wx:if="{{contract.status === 'signed'}}">
      <view class="section-title">签署信息</view>
      <view class="sign-list">
        <view class="sign-item">
          <text class="sign-label">甲方签署</text>
          <image class="sign-image" src="{{contract.partyASignature}}" mode="aspectFit"></image>
        </view>
        <view class="sign-item">
          <text class="sign-label">乙方签署</text>
          <image class="sign-image" src="{{contract.partyBSignature}}" mode="aspectFit"></image>
        </view>
      </view>
      <text class="sign-time">签署时间：{{contract.signedAt}}</text>
    </view>
  </view>
  
  <!-- 底部操作 -->
  <view class="bottom-actions">
    <button class="btn-edit" bindtap="onEdit" wx:if="{{contract.status === 'draft'}}">编辑</button>
    <button class="btn-delete" bindtap="onDelete">删除</button>
    <button class="btn-share" bindtap="onShare">分享</button>
    <button class="btn-download" bindtap="onDownload" wx:if="{{contract.status === 'signed'}}">下载</button>
  </view>
  
  <!-- 分享菜单 -->
  <view class="share-mask" wx:if="{{showShareMenu}}" bindtap="onCloseShare">
    <view class="share-menu" catchtap="noop">
      <view class="menu-title">分享给</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="onShareWechat">
          <text class="menu-icon">💬</text>
          <text class="menu-text">微信好友</text>
        </view>
        <view class="menu-item" bindtap="onShareFriend">
          <text class="menu-icon">👥</text>
          <text class="menu-text">朋友圈</text>
        </view>
      </view>
      <view class="menu-close" bindtap="onCloseShare">取消</view>
    </view>
  </view>
</view>
