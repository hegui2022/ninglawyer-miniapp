/* 码上签约 - 首页样式 */
.index-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 160rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.stats-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stats-success {
  color: #E8F5E9;
}

.stats-warning {
  color: #FFF3E0;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  background: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.action-title {
  font-size: 24rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.action-desc {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
}

/* 最近合同 */
.recent-section {
  background: #ffffff;
  padding: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #07C160;
}

.contract-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contract-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.contract-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.contract-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.contract-info {
  display: flex;
  flex-direction: column;
}

.contract-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.contract-type {
  font-size: 22rpx;
  color: #999999;
}

.contract-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.contract-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.contract-status.status-signed {
  background: #E8F5E9;
  color: #07C160;
}

.contract-status.status-pending {
  background: #FFF3E0;
  color: #FF9800;
}

.contract-date {
  font-size: 22rpx;
  color: #999999;
}

/* 浮动按钮 */
.fab-section {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  z-index: 1000;
}

.fab-btn {
  width: 112rpx;
  height: 112rpx;
  background: #07C160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.4);
  padding: 0;
  border: none;
}

.fab-btn::after {
  border: none;
}

.fab-icon {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}
