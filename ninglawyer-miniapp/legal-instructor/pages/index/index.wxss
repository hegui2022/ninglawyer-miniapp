/* 首页样式 */

/* 轮播图 */
.banner-section {
  width: 100%;
  height: 360rpx;
  background-color: #F7F7F7;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.banner-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 章节容器 */
.section {
  padding: 32rpx 0;
  background-color: #FFFFFF;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.section-more {
  font-size: 28rpx;
  color: #999999;
}

/* 服务网格 */
.services-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 24rpx;
  padding: 0 32rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-size: 48rpx;
}

.service-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111111;
  margin-bottom: 8rpx;
  text-align: center;
}

.service-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 120rpx;
}

/* 咨询列表 */
.consultation-list {
  padding: 0 32rpx;
}

.consultation-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #F7F7F7;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.consultation-item:last-child {
  margin-bottom: 0;
}

.consultation-content {
  flex: 1;
}

.consultation-title {
  display: block;
  font-size: 30rpx;
  color: #111111;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.consultation-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.consultation-count {
  font-size: 24rpx;
  color: #999999;
}

.consultation-lawyer {
  font-size: 24rpx;
  color: #07C160;
}

.consultation-arrow {
  font-size: 48rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
}

/* 新闻列表 */
.news-list {
  padding: 0 32rpx;
}

.news-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E5E5E5;
}

.news-item:last-child {
  border-bottom: none;
}

.news-content {
  display: flex;
  flex-direction: column;
}

.news-title {
  font-size: 30rpx;
  color: #111111;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.news-date {
  font-size: 24rpx;
  color: #999999;
}
