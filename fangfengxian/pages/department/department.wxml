<!--pages/department/department.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="人力资源" showBack="{{true}}" bind:back="goBack"></nav-bar>

  <!-- 功能标签区 -->
  <view class="tab-section">
    <view class="tab-list">
      <view class="tab-item {{currentTab === 'recruit' ? 'active' : ''}}" bindtap="switchTab" data-tab="recruit">
        <text class="tab-text">招聘</text>
      </view>
      <view class="tab-divider">|</view>
      <view class="tab-item {{currentTab === 'onboarding' ? 'active' : ''}}" bindtap="switchTab" data-tab="onboarding">
        <text class="tab-text">入职</text>
      </view>
      <view class="tab-divider">|</view>
      <view class="tab-item {{currentTab === 'working' ? 'active' : ''}}" bindtap="switchTab" data-tab="working">
        <text class="tab-text">在职</text>
      </view>
      <view class="tab-divider">|</view>
      <view class="tab-item {{currentTab === 'resignation' ? 'active' : ''}}" bindtap="switchTab" data-tab="resignation">
        <text class="tab-text">离职</text>
      </view>
    </view>
  </view>

  <!-- 岗位列表区 -->
  <view class="position-section">
    <scroll-view scroll-x="{{true}}" class="position-scroll" show-scrollbar="{{false}}">
      <view class="position-list">
        <!-- 总监 -->
        <view class="position-item" bindtap="viewPosition" data-position="director">
          <view class="position-avatar female">
            <text class="avatar-icon">👩</text>
          </view>
          <text class="position-name">总监</text>
        </view>

        <!-- 会计 -->
        <view class="position-item" bindtap="viewPosition" data-position="accountant">
          <view class="position-avatar male">
            <text class="avatar-icon">👨</text>
          </view>
          <text class="position-name">会计</text>
        </view>

        <!-- 出纳 -->
        <view class="position-item" bindtap="viewPosition" data-position="cashier">
          <view class="position-avatar animal">
            <text class="avatar-icon">🐱</text>
          </view>
          <text class="position-name">出纳</text>
        </view>

        <!-- 人事专员 -->
        <view class="position-item" bindtap="viewPosition" data-position="specialist">
          <view class="position-avatar female">
            <text class="avatar-icon">👩</text>
          </view>
          <text class="position-name">人事专员</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 时间戳 -->
  <view class="timestamp-section">
    <text class="timestamp">3月17日 下午13点10分</text>
  </view>

  <!-- 聊天消息区 -->
  <view class="chat-section">
    <!-- 审批结果卡片 -->
    <view class="message-card">
      <!-- 来源信息 -->
      <view class="message-source">
        <view class="source-avatar">
          <text>👤</text>
        </view>
        <text class="source-text">合规部</text>
      </view>

      <!-- 消息气泡 -->
      <view class="message-bubble">
        <text class="message-text">经知产部门研究决定：</text>
        <text class="message-text">同意聘用王三入职知识产权部门</text>
      </view>

      <!-- 审批印章 -->
      <view class="approval-stamp">
        <text class="stamp-text">已批准</text>
      </view>

      <!-- 签批人 -->
      <view class="approver-info">
        <text class="approver-text">签批人：李经理</text>
      </view>
    </view>
  </view>

  <!-- 底部聊天工具栏 -->
  <view class="chat-toolbar">
    <!-- 输入区域 -->
    <view class="input-area">
      <view class="voice-btn" bindtap="toggleInputMode">
        <text>{{inputMode === 'text' ? '🎤' : '⌨️'}}</text>
      </view>

      <view wx:if="{{inputMode === 'text'}}" class="text-input">
        <input placeholder="请输入消息" value="{{inputText}}" bindinput="onInput" />
      </view>

      <view wx:else class="voice-input" bindtouchstart="startRecord" bindtouchend="endRecord">
        <text>按住说话</text>
      </view>

      <view class="add-btn" bindtap="showFunctionPanel">
        <text>＋</text>
      </view>
    </view>
  </view>

  <!-- 功能面板 -->
  <view class="function-panel {{showPanel ? 'show' : ''}}" catchtouchmove="preventMove">
    <view class="panel-mask" bindtap="hideFunctionPanel"></view>
    <view class="panel-content">
      <!-- 搜索栏 -->
      <view class="search-bar">
        <view class="menu-btn">
          <text>☰</text>
        </view>
        <view class="search-input">
          <input placeholder="搜索功能" />
        </view>
        <view class="panel-add-btn">
          <text>+</text>
        </view>
      </view>

      <!-- 快捷功能按钮 -->
      <view class="quick-functions">
        <!-- 第一行 -->
        <view class="function-item" bindtap="goToFunction" data-func="plan">
          <view class="function-icon">
            <text>📋</text>
          </view>
          <text class="function-text">招聘计划</text>
        </view>

        <view class="function-item" bindtap="goToFunction" data-func="announcement">
          <view class="function-icon">
            <text>📢</text>
          </view>
          <text class="function-text">招聘公告</text>
        </view>

        <view class="function-item" bindtap="goToFunction" data-func="declaration">
          <view class="function-icon">
            <text>📝</text>
          </view>
          <text class="function-text">入股声明</text>
        </view>

        <view class="function-item" bindtap="goToFunction" data-func="upload">
          <view class="function-icon">
            <text>📤</text>
          </view>
          <text class="function-text">上传文件</text>
        </view>

        <!-- 第二行 -->
        <view class="function-item" bindtap="goToFunction" data-func="rules">
          <view class="function-icon">
            <text>📖</text>
          </view>
          <text class="function-text">规则制度</text>
        </view>

        <view class="function-item" bindtap="goToFunction" data-func="employee">
          <view class="function-icon">
            <text>👥</text>
          </view>
          <text class="function-text">员工</text>
        </view>
      </view>
    </view>
  </view>
</view>
