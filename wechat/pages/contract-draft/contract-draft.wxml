<!--pages/contract-draft/contract-draft.wxml-->
<view class="container">
  <!-- 步骤指示器 -->
  <view class="steps" wx:if="{{step > 0}}">
    <view class="step-item {{step >= 1 ? 'active' : ''}}">
      <view class="step-number">1</view>
      <view class="step-text">选择类型</view>
    </view>
    <view class="step-line"></view>
    <view class="step-item {{step >= 2 ? 'active' : ''}}">
      <view class="step-number">2</view>
      <view class="step-text">填写信息</view>
    </view>
    <view class="step-line"></view>
    <view class="step-item {{step >= 3 ? 'active' : ''}}">
      <view class="step-number">3</view>
      <view class="step-text">生成合同</view>
    </view>
  </view>

  <!-- 步骤1：选择合同类型 -->
  <view class="step-content" wx:if="{{step === 0}}">
    <view class="section-title">选择合同类型</view>
    
    <view class="contract-types">
      <view class="type-card" wx:for="{{contractTypes}}" wx:key="id" bindtap="selectContractType(item.id)">
        <view class="type-icon">{{item.icon}}</view>
        <view class="type-title">{{item.name}}</view>
        <view class="type-desc">{{item.description}}</view>
        <view class="type-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 步骤2：填写信息 -->
  <view class="step-content" wx:if="{{step === 1}}">
    <view class="section-title">填写合同信息</view>
    <view class="form-section">
      <view class="form-item">
        <view class="form-label">合同名称 <text class="required">*</text></view>
        <input class="form-input" placeholder="请输入合同名称" value="{{formData.contract_name}}" bindinput="onInputChange" data-field="contract_name" />
      </view>

      <view class="form-item">
        <view class="form-label">用人单位名称 <text class="required">*</text></view>
        <input class="form-input" placeholder="请输入用人单位全称" value="{{formData.employer_name}}" bindinput="onInputChange" data-field="employer_name" />
      </view>

      <view class="form-item">
        <view class="form-label">劳动者姓名 <text class="required">*</text></view>
        <input class="form-input" placeholder="请输入劳动者姓名" value="{{formData.employee_name}}" bindinput="onInputChange" data-field="employee_name" />
      </view>

      <view class="form-item">
        <view class="form-label">合同内容</view>
        <textarea class="form-textarea" placeholder="请输入合同内容（可选，留空则使用模板）" value="{{formData.contract_content}}" bindinput="onInputChange" data-field="contract_content" />
      </view>
    </view>

    <view class="actions">
      <view class="btn btn-secondary" bindtap="previousStep">上一步</view>
      <view class="btn" bindtap="nextStep">下一步</view>
    </view>
  </view>

  <!-- 步骤3：预览和保存 -->
  <view class="step-content" wx:if="{{step === 2}}">
    <view class="section-title">合同预览</view>
    <view class="preview-content">
      <text class="preview-text">{{contractPreview || '暂无内容'}}</text>
    </view>

    <view class="actions">
      <view class="btn btn-secondary" bindtap="previousStep">返回修改</view>
      <view class="btn" bindtap="saveContract">保存合同</view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
