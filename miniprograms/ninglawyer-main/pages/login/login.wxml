<view class="login-container">
  <view class="header">
    <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
    <text class="title">宁律师法律咨询</text>
    <text class="subtitle">专业、便捷、安全的法律服务平台</text>
  </view>

  <view class="content">
    <button class="login-btn wechat-btn" bindtap="handleWechatLogin">
      <image class="wechat-icon" src="/static/icons/wechat.png"></image>
      <text>微信一键登录</text>
    </button>

    <view class="divider">
      <view class="line"></view>
      <text class="text">或</text>
      <view class="line"></view>
    </view>

    <view class="form">
      <view class="form-item">
        <input class="input" placeholder="请输入手机号" type="number" maxlength="11" bindinput="onPhoneInput" value="{{phone}}" />
      </view>

      <view class="form-item">
        <input class="input code-input" placeholder="请输入验证码" type="number" maxlength="6" bindinput="onCodeInput" value="{{code}}" />
        <button class="code-btn" bindtap="sendCode" disabled="{{sending || countDown > 0}}">
          {{countDown > 0 ? countDown + 's' : sending ? '发送中...' : '获取验证码'}}
        </button>
      </view>

      <button class="login-btn phone-btn" bindtap="handlePhoneLogin" disabled="{{!phone || !code}}">
        登录
      </button>
    </view>
  </view>

  <view class="footer">
    <text class="agreement">登录即表示同意</text>
    <text class="link" bindtap="showAgreement">《用户协议》</text>
    <text class="agreement">和</text>
    <text class="link" bindtap="showPrivacy">《隐私政策》</text>
  </view>
</view>
