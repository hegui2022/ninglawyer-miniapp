<!-- 理约首页 -->
<view class="index-page">
  <!-- 概览卡片 -->
  <view class="overview-section">
    <view class="section-header">
      <text class="section-title">履约概览</text>
      <text class="section-icon">📊</text>
    </view>
    <view class="overview-grid">
      <view class="overview-item">
        <text class="overview-value">{{overview.totalContracts}}</text>
        <text class="overview-label">全部合同</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{overview.activeContracts}}</text>
        <text class="overview-label">履约中</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{overview.expiringSoon}}</text>
        <text class="overview-label">即将到期</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{overview.completedMilestones}}</text>
        <text class="overview-label">已完成节点</text>
      </view>
    </view>
  </view>
  
  <!-- 即将到期 -->
  <view class="expiring-section">
    <view class="section-header">
      <text class="section-title">即将到期</text>
      <text class="section-more" bindtap="onAllContracts">查看全部 ›</text>
    </view>
    <view class="expiring-list">
      <view 
        class="expiring-item" 
        wx:for="{{expiringContracts}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onContractTap"
      >
        <view class="expiring-header">
          <text class="contract-title">{{item.title}}</text>
          <view class="days-badge {{item.daysLeft <= 30 ? 'urgent' : 'normal'}}">
            {{item.daysLeft}} 天
          </view>
        </view>
        <view class="expiring-info">
          <text class="info-text">{{item.partyA}} - {{item.partyB}}</text>
          <text class="info-date">到期：{{item.endDate}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 最近活动 -->
  <view class="activity-section">
    <view class="section-header">
      <text class="section-title">最近活动</text>
      <text class="section-more" bindtap="onAllReminders">查看全部 ›</text>
    </view>
    <view class="activity-list">
      <view 
        class="activity-item" 
        wx:for="{{recentActivities}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onActivityTap"
      >
        <view class="activity-icon">
          <text class="icon-emoji">{{item.activityType === 'payment' ? '💰' : item.activityType === 'milestone' ? '🎯' : item.activityType === 'renewal' ? '🔄' : '🛡️'}}</text>
        </view>
        <view class="activity-content">
          <view class="activity-title">{{item.contractTitle}}</view>
          <view class="activity-desc">{{item.description}}</view>
        </view>
        <view class="activity-right">
          <text class="activity-status {{item.status}}">{{item.status === 'pending' ? '待处理' : '已完成'}}</text>
          <text class="activity-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="onAllContracts">
      <view class="action-icon">📋</view>
      <text class="action-label">全部合同</text>
    </view>
    <view class="action-item" bindtap="onAllReminders">
      <view class="action-icon">🔔</view>
      <text class="action-label">履约提醒</text>
    </view>
    <view class="action-item" bindtap="onSettings">
      <view class="action-icon">⚙️</view>
      <text class="action-label">提醒设置</text>
    </view>
  </view>
</view>
