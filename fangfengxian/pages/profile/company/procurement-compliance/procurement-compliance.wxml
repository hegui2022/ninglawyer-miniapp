<!--pages/profile/company/procurement-compliance/procurement-compliance.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="采购合规" showBack="{{true}}" bind:back="goBack"></nav-bar>

  <!-- 采购风险识别模块 -->
  <view class="search-section" bindtap="goToSearch">
    <view class="search-icon">
      <text>🔍</text>
    </view>
    <text class="search-text">采购风险识别</text>
  </view>

  <!-- 分割线 -->
  <view class="divider"></view>

  <!-- 合规义务清单 -->
  <view class="module-section">
    <view class="section-title">合规义务清单</view>
    <view class="item-list">
      <view class="item" bindtap="goToDetail" data-item="must-comply">
        <text class="item-text">企业必须遵守</text>
        <text class="item-arrow">›</text>
      </view>
      <view class="item" bindtap="goToDetail" data-item="promise-comply">
        <text class="item-text">企业承诺遵守</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider"></view>

  <!-- 权力清单 -->
  <view class="module-section">
    <view class="section-title">权力清单</view>
    <view class="item-list">
      <view class="item active" bindtap="goToDetail" data-item="review-power">
        <text class="item-text">审核权</text>
        <text class="item-icon">⚡</text>
        <text class="item-arrow">›</text>
        <!-- 蓝色高亮条 -->
        <view class="active-bar"></view>
      </view>
      <view class="item" bindtap="goToDetail" data-item="procurement-power">
        <text class="item-text">采购权</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider"></view>

  <!-- 采购流程表 -->
  <view class="module-section">
    <view class="section-title">采购流程表</view>
    <view class="item-list">
      <view class="item" bindtap="goToDetail" data-item="confirm-requirement">
        <text class="item-text">确认需求</text>
        <text class="item-arrow">›</text>
      </view>
      <view class="item" bindtap="goToDetail" data-item="procurement-application">
        <text class="item-text">采购申请</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- Home 指示条 -->
  <home-indicator></home-indicator>
</view>
