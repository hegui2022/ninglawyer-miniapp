<!--pages/template-list/template-list.wxml-->
<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active' : ''}}" bindtap="setFilter('all')">
      全部
    </view>
    <view class="filter-item {{filterType === 'standard' ? 'active' : ''}}" bindtap="setFilter('standard')">
      劳动合同
    </view>
    <view class="filter-item {{filterType === 'parttime' ? 'active' : ''}}" bindtap="setFilter('parttime')">
      非全日制
    </view>
    <view class="filter-item {{filterType === 'intern' ? 'active' : ''}}" bindtap="setFilter('intern')">
      实习协议
    </view>
    <view class="filter-item {{filterType === 'retired' ? 'active' : ''}}" bindtap="setFilter('retired')">
      退休返聘
    </view>
    <view class="filter-item {{filterType === 'project' ? 'active' : ''}}" bindtap="setFilter('project')">
      项目制
    </view>
    <view class="filter-item {{filterType === 'dispatch' ? 'active' : ''}}" bindtap="setFilter('dispatch')">
      劳务派遣
    </view>
  </view>

  <!-- 模板列表 -->
  <view class="template-list" wx:if="{{templates.length > 0}}">
    <view class="template-item" wx:for="{{templates}}" wx:key="id" bindtap="goToDetail(item.id)">
      <view class="template-header">
        <view class="template-icon">{{item.icon}}</view>
        <view class="template-title-group">
          <view class="template-title">{{item.template_name}}</view>
          <view class="template-type">{{item.type_name}}</view>
        </view>
      </view>

      <view class="template-desc">{{item.description}}</view>

      <view class="template-footer">
        <view class="template-meta">
          <text class="meta-icon">📅</text>
          <text class="meta-text">{{item.created_at}}</text>
        </view>
        <view class="btn btn-sm">使用模板</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无模板</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
