<!-- 怎么判首页 -->
<view class="index-page">
  <!-- 顶部 Banner -->
  <view class="banner">
    <image class="banner-image" src="https://via.placeholder.com/750x400/07C160/ffffff?text=怎么判" mode="aspectFill"></image>
    <view class="banner-content">
      <text class="banner-title">怎么判</text>
      <text class="banner-subtitle">智能违约判断 · 权威维权指导 · 全面判例查询</text>
    </view>
  </view>
  
  <!-- 服务入口 -->
  <view class="services-section">
    <view class="section-header">
      <text class="section-title">核心功能</text>
      <text class="section-icon">⚡</text>
    </view>
    <view class="services-grid">
      <view 
        class="service-card" 
        wx:for="{{services}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onServiceTap"
      >
        <view class="service-icon" style="background: {{item.color}};">
          <text class="icon-text">{{item.icon}}</text>
        </view>
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.description}}</text>
      </view>
    </view>
  </view>
  
  <!-- 最近案例 -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">最近判断</text>
      <text class="section-more">查看全部 ›</text>
    </view>
    <view class="recent-list">
      <view 
        class="recent-item" 
        wx:for="{{recentCases}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCaseTap"
      >
        <view class="recent-icon">
          <text>📄</text>
        </view>
        <view class="recent-content">
          <text class="recent-title">{{item.title}}</text>
          <view class="recent-meta">
            <text class="recent-result">结果：{{item.result}}</text>
            <text class="recent-date">{{item.date}}</text>
          </view>
        </view>
        <text class="recent-arrow">›</text>
      </view>
    </view>
  </view>
  
  <!-- 热门话题 -->
  <view class="topics-section">
    <view class="section-header">
      <text class="section-title">热门话题</text>
    </view>
    <view class="topics-list">
      <view 
        class="topic-tag" 
        wx:for="{{hotTopics}}" 
        wx:key="*this"
        data-topic="{{item}}"
        bindtap="onTopicTap"
      >
        {{item}}
      </view>
    </view>
  </view>
  
  <!-- 咨询入口 -->
  <view class="consult-section">
    <view class="consult-card" bindtap="onConsult">
      <text class="consult-icon">💬</text>
      <view class="consult-content">
        <text class="consult-title">需要更详细的法律咨询？</text>
        <text class="consult-desc">专业律师为您提供一对一服务</text>
      </view>
      <text class="consult-arrow">›</text>
    </view>
  </view>
</view>
