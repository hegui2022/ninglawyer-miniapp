/* components/nav-bar/nav-bar.wxss */

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E5E5E5;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 44rpx;
  padding: 0 32rpx;
}

.status-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-center {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

.status-right {
  display: flex;
  align-items: center;
}

.status-icon {
  width: 36rpx;
  height: 36rpx;
  font-size: 32rpx;
  line-height: 1;
}

/* 导航栏 */
.nav-content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
}

/* 返回按钮 */
.back-button {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #000000;
  font-weight: bold;
}

/* 标题 */
.nav-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #000000;
  text-align: center;
}

/* 如果有返回按钮，标题居左显示 */
.nav-bar.has-back .nav-title {
  text-align: left;
  padding-left: 0;
}
