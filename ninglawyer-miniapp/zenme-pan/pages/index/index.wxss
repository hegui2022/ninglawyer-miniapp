/* 怎么判首页样式 */
.index-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 24rpx;
}

/* Banner */
.banner {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx 32rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
}

.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 服务区块 */
.services-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-icon {
  font-size: 32rpx;
}

.section-more {
  font-size: 24rpx;
  color: #07C160;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.service-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  gap: 16rpx;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.icon-text {
  font-size: 48rpx;
}

.service-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

.service-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

/* 最近案例 */
.recent-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  gap: 16rpx;
}

.recent-icon {
  width: 64rpx;
  height: 64rpx;
  background: #ffffff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
}

.recent-content {
  flex: 1;
  min-width: 0;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.recent-meta {
  display: flex;
  gap: 16rpx;
}

.recent-result {
  font-size: 22rpx;
  color: #F44336;
  font-weight: 600;
}

.recent-date {
  font-size: 22rpx;
  color: #999999;
}

.recent-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
}

/* 热门话题 */
.topics-section {
  background: #ffffff;
  padding: 32rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}

.topics-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 16rpx 32rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #333333;
}

/* 咨询入口 */
.consult-section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.consult-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.consult-icon {
  font-size: 48rpx;
}

.consult-content {
  flex: 1;
}

.consult-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.consult-desc {
  font-size: 22rpx;
  color: #999999;
}

.consult-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}
