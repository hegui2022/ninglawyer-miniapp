<!--pages/guide/guide.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="指引" showBack="{{false}}"></nav-bar>

  <!-- 内容列表区 -->
  <view class="content-list">
    <!-- 展开的内容卡片 -->
    <content-card wx:if="{{item1Expanded}}" title="网络安全等级保护义务" subtitle="网络安" iconName="✏️">
      <view class="card-content">
        <view class="content-item">
          <text class="item-number">1、</text>
          <text class="item-text">公司采取了防范计算机病毒和网络攻击、网络侵入等危害网络安全行为的技术措施，如公司部界了专业防火墙、办公桌面安装了杀毒软件；</text>
        </view>

        <view class="content-item">
          <text class="item-number">2、</text>
          <text class="item-text">公司采取了监测、记录网络运行状态、网络安全事件的技术措施，如公司部署的防火墙具备网络异常监测和运行日志功能；</text>
        </view>

        <view class="content-item">
          <text class="item-number">3、</text>
          <text class="item-text">公司采取了备份、加密、访问控制等必要措施，保障数据免遭泄密、窃取、篡改、毁损、丢失。</text>
        </view>

        <view class="read-more" bindtap="goToArticle">
          <text class="read-more-text">阅读全文 ></text>
        </view>
      </view>
    </content-card>

    <!-- 收起时的简略卡片 -->
    <view wx:else class="collapsed-card" bindtap="toggleItem1">
      <view class="collapsed-title">网络安全等级保护义务</view>
      <view class="collapsed-subtitle">网络安</view>
    </view>

    <!-- 第二个卡片 -->
    <content-card wx:if="{{item2Expanded}}" title="数据安全管理义务" subtitle="数据安" iconName="🔒">
      <view class="card-content">
        <view class="content-item">
          <text class="item-number">1、</text>
          <text class="item-text">公司采取了防范计算机病毒和网络攻击、网络侵入等危害网络安全行为的技术措施，如公司部界了专业防火墙、办公桌面安装了杀毒软件；</text>
        </view>

        <view class="content-item">
          <text class="item-number">2、</text>
          <text class="item-text">公司采取了监测、记录网络运行状态、网络安全事件的技术措施，如公司部署的防火墙具备网络异常监测和运行日志功能；</text>
        </view>

        <view class="content-item">
          <text class="item-number">3、</text>
          <text class="item-text">公司采取了备份、加密、访问控制等必要措施，保障数据免遭泄密、窃取、篡改、毁损、丢失。</text>
        </view>
      </view>
    </content-card>

    <view wx:else class="collapsed-card" bindtap="toggleItem2">
      <view class="collapsed-title">数据安全管理义务</view>
      <view class="collapsed-subtitle">数据安</view>
    </view>

    <!-- 第三个卡片 -->
    <content-card wx:if="{{item3Expanded}}" title="个人信息保护义务" subtitle="个人信" iconName="🛡️">
      <view class="card-content">
        <view class="content-item">
          <text class="item-number">1、</text>
          <text class="item-text">公司采取了防范计算机病毒和网络攻击、网络侵入等危害网络安全行为的技术措施，如公司部界了专业防火墙、办公桌面安装了杀毒软件；</text>
        </view>

        <view class="content-item">
          <text class="item-number">2、</text>
          <text class="item-text">公司采取了监测、记录网络运行状态、网络安全事件的技术措施，如公司部署的防火墙具备网络异常监测和运行日志功能；</text>
        </view>
      </view>
    </content-card>

    <view wx:else class="collapsed-card" bindtap="toggleItem3">
      <view class="collapsed-title">个人信息保护义务</view>
      <view class="collapsed-subtitle">个人信</view>
    </view>
  </view>

  <!-- TabBar 组件 -->
  <tab-bar currentPath="/pages/guide/guide"></tab-bar>
</view>
