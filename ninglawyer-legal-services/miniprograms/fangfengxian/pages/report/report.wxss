/* pages/report/report.wxss */

/* 报告头部 */
.report-header {
  background: linear-gradient(135deg, #07C160 0%, #06A850 100%);
  color: #ffffff;
}

.header-title {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.title-date {
  font-size: 24rpx;
  opacity: 0.9;
}

.header-summary {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 风险趋势 */
.risk-trend {
  margin-bottom: 24rpx;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 40rpx 0;
  height: 300rpx;
}

.trend-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 8rpx;
}

.trend-fill {
  width: 40rpx;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s;
}

.trend-label {
  font-size: 20rpx;
  color: #666666;
  margin-top: 8rpx;
}

/* 风险分类 */
.risk-categories {
  margin-bottom: 24rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item:last-child {
  border-bottom: none;
}

.category-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 36rpx;
  color: #ffffff;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.category-desc {
  font-size: 24rpx;
  color: #999999;
}

.category-right {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.category-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 8rpx;
}

.category-arrow {
  font-size: 28rpx;
  color: #999999;
}

/* 详细风险 */
.detail-risks {
  margin-bottom: 24rpx;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
}

.tab-item {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #666666;
  background-color: #f7f7f7;
  border-radius: 4rpx;
}

.tab-item.active {
  color: #ffffff;
  background-color: #07C160;
}

.risk-list {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.risk-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
  border-left: 4rpx solid;
}

.risk-item.risk-high {
  border-left-color: #F44336;
}

.risk-item.risk-medium {
  border-left-color: #FF9800;
}

.risk-item.risk-low {
  border-left-color: #07C160;
}

.risk-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  margin-bottom: 12rpx;
}

.risk-item.risk-high .risk-badge {
  background-color: rgba(244, 67, 54, 0.1);
  color: #F44336;
}

.risk-item.risk-medium .risk-badge {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.risk-item.risk-low .risk-badge {
  background-color: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.risk-content {
  display: flex;
  flex-direction: column;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.risk-desc {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.risk-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-item {
  font-size: 20rpx;
  color: #999999;
}

/* 改进建议 */
.suggestions {
  margin-bottom: 24rpx;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #07C160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.suggestion-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.suggestion-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

/* 操作按钮 */
.action-buttons {
  padding: 24rpx 0;
}

.action-buttons .btn {
  margin-bottom: 16rpx;
}

.action-buttons .btn:last-child {
  margin-bottom: 0;
}
