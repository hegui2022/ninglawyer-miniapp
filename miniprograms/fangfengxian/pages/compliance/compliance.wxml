<!--pages/compliance/compliance.wxml-->
<view class="container">
  <!-- 检查类型 -->
  <view class="card check-types">
    <view class="card-header">
      <text class="card-title">检查类型</text>
    </view>
    <view class="type-grid">
      <view
        class="type-item {{selectedType === item.value ? 'active' : ''}}"
        wx:for="{{checkTypes}}"
        wx:key="value"
        bindtap="selectType"
        data-value="{{item.value}}"
      >
        <text class="type-icon">{{item.icon}}</text>
        <text class="type-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 合规要求列表 -->
  <view class="card compliance-list">
    <view class="card-header">
      <text class="card-title">合规要求</text>
      <text class="check-count">{{passedCount}}/{{totalItems}} 项通过</text>
    </view>
    <view class="compliance-items">
      <view class="compliance-item" wx:for="{{complianceItems}}" wx:key="id">
        <view class="item-left">
          <view class="item-check {{item.passed ? 'passed' : 'failed'}}">
            <text class="check-icon">{{item.passed ? '✓' : '✗'}}</text>
          </view>
          <view class="item-content">
            <text class="item-title">{{item.title}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
        </view>
        <view class="item-right">
          <text class="item-status {{item.passed ? 'pass' : 'fail'}}">
            {{item.passed ? '通过' : '未通过'}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 未通过详情 -->
  <view class="card failed-items" wx:if="{{failedItems.length > 0}}">
    <view class="card-header">
      <text class="card-title">需要改进</text>
    </view>
    <view class="failed-list">
      <view class="failed-item" wx:for="{{failedItems}}" wx:key="id">
        <view class="failed-icon">
          <text class="iconfont">⚠️</text>
        </view>
        <view class="failed-content">
          <text class="failed-title">{{item.title}}</text>
          <text class="failed-reason">原因：{{item.reason}}</text>
          <view class="failed-suggestion">
            <text class="suggestion-label">建议：</text>
            <text class="suggestion-text">{{item.suggestion}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn btn-primary btn-block btn-large" bindtap="startCheck">
      开始检查
    </button>
    <button class="btn btn-outline btn-block" bindtap="viewDetails">
      查看详情
    </button>
  </view>
</view>
