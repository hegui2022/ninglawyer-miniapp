# 扣子Bot API Token配置
# 请复制此文件为 .env 并填入真实的API Token
# .env文件不会被提交到git，确保安全

# 脱敏Bot Token
COZE_DESENSITIZE_BOT_TOKEN=pat_your_token_here

# 民事咨询Bot Token
COZE_CIVIL_CONSULT_BOT_TOKEN=pat_your_token_here

# 合同起草Bot Token
COZE_CONTRACT_DRAFT_BOT_TOKEN=pat_your_token_here

# 合同审查Bot Token
COZE_CONTRACT_REVIEW_BOT_TOKEN=pat_your_token_here

# 扣子平台基础配置
COZE_API_BASE_URL=https://api.coze.cn/v3
