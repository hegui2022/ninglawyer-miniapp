<view class="container">
  <!-- 当前套餐卡片 -->
  <view class="current-plan-card">
    <view class="card-header">
      <text class="card-title">当前套餐</text>
      <text class="plan-badge">{{ currentPlan.subscription_name }}</text>
    </view>
    
    <view class="card-body">
      <view class="plan-info">
        <view class="info-item">
          <text class="label">价格</text>
          <text class="value price">¥{{ currentPlan.subscription_price }}/月</text>
        </view>
        
        <view class="info-item" wx:if="{{ currentPlan.subscription_end_at }}">
          <text class="label">到期时间</text>
          <text class="value">{{ currentPlan.formatted_end_date }}</text>
          <text class="value days-left" wx:if="{{ currentPlan.days_remaining > 0 }}">
            (剩余{{ currentPlan.days_remaining }}天)
          </text>
          <text class="value expired" wx:if="{{ currentPlan.days_remaining <= 0 }}">
            (已过期)
          </text>
        </view>
      </view>
      
      <view class="plan-features">
        <text class="features-title">包含功能：</text>
        <view class="features-list">
          <text class="feature-item" wx:for="{{ currentPlan.features }}" wx:key="index">
            ✓ {{ item }}
          </text>
        </view>
      </view>
    </view>
    
    <view class="card-footer">
      <button class="btn btn-secondary" bindtap="handleViewUsage">使用统计</button>
      <button class="btn btn-secondary" bindtap="handleViewFeatures">功能详情</button>
    </view>
  </view>

  <!-- 可用套餐列表 -->
  <view class="plans-section">
    <text class="section-title">升级套餐</text>
    
    <view class="plans-list">
      <view 
        class="plan-card {{ selectedPlan === item.id ? 'selected' : '' }}" 
        wx:for="{{ availablePlans }}" 
        wx:key="id"
        data-plan="{{ item.id }}"
        bindtap="handleSelectPlan"
      >
        <view class="plan-card-header">
          <text class="plan-name">{{ item.name }}</text>
          <text class="plan-price">¥{{ item.price }}/{{ item.duration }}天</text>
        </view>
        
        <text class="plan-description">{{ item.description }}</text>
        
        <view class="plan-mini-features">
          <text class="mini-feature" wx:for="{{ item.features }}" wx:for-item="feature" wx:key="*this">
            • {{ feature }}
          </text>
        </view>
        
        <view class="plan-select-indicator" wx:if="{{ selectedPlan === item.id }}">
          <text class="indicator-text">已选择</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-actions">
    <button 
      class="btn btn-primary btn-large" 
      bindtap="handleUpgrade"
      disabled="{{ !selectedPlan || loading }}"
    >
      {{ loading ? '处理中...' : '确认' }}
    </button>
  </view>
</view>

<!-- 加载提示 -->
<view class="loading-mask" wx:if="{{ loading }}">
  <view class="loading-content">
    <text class="loading-text">加载中...</text>
  </view>
</view>
