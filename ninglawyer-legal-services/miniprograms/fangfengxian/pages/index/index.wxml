<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部卡片 -->
  <view class="header-card">
    <view class="header-content">
      <view class="user-info">
        <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-details">
          <text class="username">{{userInfo.name || '未登录'}}</text>
          <text class="user-role">{{userInfo.role || '访客'}}</text>
        </view>
      </view>
      <view class="risk-badge risk-{{riskLevel}}">
        <text class="risk-level-text">{{riskLevelText}}</text>
      </view>
    </view>
  </view>

  <!-- 风险概览 -->
  <view class="card risk-overview">
    <view class="card-header">
      <text class="card-title">风险概览</text>
      <text class="card-more" bindtap="goToScan">扫描 > </text>
    </view>
    <view class="risk-stats">
      <view class="stat-item" bindtap="goToReport">
        <view class="stat-value risk-high">{{riskCount.high}}</view>
        <view class="stat-label">高风险</view>
      </view>
      <view class="stat-item" bindtap="goToReport">
        <view class="stat-value risk-medium">{{riskCount.medium}}</view>
        <view class="stat-label">中风险</view>
      </view>
      <view class="stat-item" bindtap="goToReport">
        <view class="stat-value risk-low">{{riskCount.low}}</view>
        <view class="stat-label">低风险</view>
      </view>
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="card quick-actions">
    <view class="card-header">
      <text class="card-title">快捷功能</text>
    </view>
    <view class="action-grid">
      <view class="action-item" bindtap="goToScan">
        <image class="action-icon" src="/images/icon-scan.png" mode="aspectFit"></image>
        <text class="action-text">风险扫描</text>
      </view>
      <view class="action-item" bindtap="goToCompliance">
        <image class="action-icon" src="/images/icon-compliance.png" mode="aspectFit"></image>
        <text class="action-text">合规检查</text>
      </view>
      <view class="action-item" bindtap="goToReport">
        <image class="action-icon" src="/images/icon-report.png" mode="aspectFit"></image>
        <text class="action-text">风险报告</text>
      </view>
      <view class="action-item" bindtap="goToAlert">
        <image class="action-icon" src="/images/icon-alert.png" mode="aspectFit"></image>
        <text class="action-text">风险预警</text>
      </view>
    </view>
  </view>

  <!-- 最近扫描 -->
  <view class="card recent-scan">
    <view class="card-header">
      <text class="card-title">最近扫描</text>
      <text class="card-more" bindtap="goToReport">查看更多 > </text>
    </view>
    <view wx:if="{{recentScans.length > 0}}">
      <view class="scan-item" wx:for="{{recentScans}}" wx:key="id" bindtap="viewScanDetail" data-id="{{item.id}}">
        <view class="scan-info">
          <view class="scan-name">{{item.name}}</view>
          <view class="scan-time">{{item.time}}</view>
        </view>
        <view class="scan-badge risk-{{item.level}}">
          <text>{{item.levelText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty">
      <image class="empty-icon" src="/images/empty-scan.png" mode="aspectFit"></image>
      <text class="empty-text">暂无扫描记录</text>
    </view>
  </view>

  <!-- 风险提示 -->
  <view class="card risk-tips">
    <view class="card-header">
      <text class="card-title">风险提示</text>
    </view>
    <view class="tips-list">
      <view class="tip-item" wx:for="{{riskTips}}" wx:key="id" bindtap="viewTipDetail" data-id="{{item.id}}">
        <view class="tip-icon">
          <text class="iconfont">⚠️</text>
        </view>
        <view class="tip-content">
          <view class="tip-title">{{item.title}}</view>
          <view class="tip-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 立即扫描按钮 -->
  <view class="scan-btn-container">
    <button class="btn btn-primary btn-block btn-large" bindtap="startScan">
      开始风险扫描
    </button>
  </view>
</view>
