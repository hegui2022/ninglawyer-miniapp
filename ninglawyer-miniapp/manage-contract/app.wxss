/* 理约小程序 - 全局样式 */
page {
  background-color: #F5F5F5;
  font-size: 28rpx;
  color: #333333;
}

.container {
  min-height: 100vh;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  color: #07C160;
  border: 2rpx solid #07C160;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.timeline-item {
  display: flex;
  margin-bottom: 32rpx;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #07C160;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
}
