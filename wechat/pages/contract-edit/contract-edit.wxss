/* pages/contract-edit/contract-edit.wxss */

.header {
  padding: 30rpx;
  text-align: center;
  background: linear-gradient(135deg, #4A90E2 0%, #67B26F 100%);
  color: #FFFFFF;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #FFFFFF;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #FFFFFF;
}

.duration-input {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.picker {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #FFFFFF;
}

.duration-separator {
  font-size: 26rpx;
  color: #999999;
}

.switch-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-group .label {
  margin-bottom: 0;
}
