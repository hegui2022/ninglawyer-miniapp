/* pages/shareholders/shareholders.wxss */
.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 120rpx;
}

/* ==================== 会议状态 ==================== */
.meeting-status {
  padding: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.status-text {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* ==================== 会议类型切换 ==================== */
.meeting-tabs {
  display: flex;
  padding: 0 32rpx 32rpx;
  gap: 24rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.tab-item.active {
  background-color: #E3F2FD;
  border-color: #4CAF50;
}

.tab-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #4CAF50;
  font-weight: bold;
}

/* ==================== 模块通用样式 ==================== */
.module-section {
  padding: 32rpx;
}

.module-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.module-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.module-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
}

.module-content {
  padding-left: 48rpx;
}

/* ==================== 召集会议模块 ==================== */
.info-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
}

.info-divider {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-link {
  font-size: 28rpx;
  color: #2196F3;
  text-decoration: underline;
}

.notice-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #F0F0F0;
}

.notice-label {
  font-size: 28rpx;
  color: #666666;
}

.notice-link {
  font-size: 28rpx;
  color: #2196F3;
  text-decoration: underline;
}

/* ==================== 主持会议模块 ==================== */
.meeting-options {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
}

.option-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
}

.option-item.active {
  background-color: #E8F5E9;
  border-color: #4CAF50;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.option-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.option-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: bold;
}

.meeting-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  margin-top: 24rpx;
}

.record-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.record-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.record-arrow {
  font-size: 40rpx;
  color: #999999;
}

/* ==================== 会议表决模块 ==================== */
.vote-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.vote-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.vote-text {
  flex: 1;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.vote-arrow {
  font-size: 40rpx;
  color: #FFFFFF;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background-color: #E5E5E5;
  margin: 0 32rpx;
}
