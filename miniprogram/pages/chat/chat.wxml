<!--pages/chat/chat.wxml-->
<view class="chat-container">
  <!-- 消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y 
    scroll-into-view="{{scrollIntoView}}" 
    scroll-with-animation="{{true}}"
    bindscrolltolower="loadMoreHistory">
    
    <!-- 欢迎消息 -->
    <view class="message lawyer" wx:if="{{messages.length === 0}}">
      <view class="avatar lawyer">👨‍⚖️</view>
      <view class="message-content">
        <view class="message-bubble lawyer">
          你好！我是宁律师，有什么法律问题尽管说，我会用大白话给你讲清楚，还能语音回复你哦！🎤
        </view>
      </view>
    </view>

    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="id">
      <view class="message {{item.role}}" id="msg-{{item.id}}">
        <!-- 律师消息 -->
        <view class="avatar lawyer" wx:if="{{item.role === 'lawyer'}}">👨‍⚖️</view>
        
        <!-- 消息内容 -->
        <view class="message-content">
          <view class="message-bubble {{item.role}}">
            <text>{{item.content}}</text>
          </view>
          
          <!-- 语音播放器 -->
          <view class="audio-player" wx:if="{{item.audioUrl && item.role === 'lawyer'}}" bindtap="playAudio" data-url="{{item.audioUrl}}">
            <image class="audio-icon" src="{{isPlayingAudio ? '/images/audio-playing.gif' : '/images/audio-static.png'}}" mode="aspectFit"></image>
            <text class="audio-duration">{{item.audioDuration || '3"}}</text>
          </view>
        </view>
        
        <!-- 用户消息 -->
        <view class="avatar user" wx:if="{{item.role === 'user'}}">👤</view>
      </view>
    </block>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="typing-dots">
        <span></span>
        <span></span>
        <span></span>
      </view>
    </view>

    <!-- 打字中 -->
    <view class="message lawyer" wx:if="{{isTyping}}">
      <view class="avatar lawyer">👨‍⚖️</view>
      <view class="message-content">
        <view class="message-bubble lawyer">
          <view class="typing-dots">
            <span></span>
            <span></span>
            <span></span>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 快捷标签（可滑动） -->
  <scroll-view class="quick-tags-scroll" scroll-x wx:if="{{!showRecorder}}">
    <block wx:for="{{quickTags}}" wx:key="index">
      <view class="quick-tag" bindtap="sendQuickTag" data-tag="{{item}}">
        {{item}}
      </view>
    </block>
  </scroll-view>

  <!-- 录音提示 -->
  <view class="recording-tip" wx:if="{{showRecorder}}">
    <text>松开发送，上滑取消</text>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <!-- 语音按钮 -->
    <view 
      class="input-btn {{showRecorder ? 'recording' : ''}}" 
      bindtouchstart="startRecord" 
      bindtouchend="endRecord" 
      bindtouchcancel="cancelRecord"
      bindtouchmove="onRecordMove">
      🎤
    </view>

    <!-- 文本输入框 -->
    <textarea 
      wx:if="{{!showRecorder}}"
      class="text-input" 
      value="{{inputText}}" 
      placeholder="输入你的法律问题..." 
      bindinput="onInput"
      bindfocus="onInputFocus"
      bindblur="onInputBlur"
      confirm-type="send"
      bindconfirm="sendMessage"
      auto-height
      maxlength="500"
    />

    <!-- 发送按钮 -->
    <view class="send-btn" wx:if="{{inputText.trim() && !showRecorder}}" bindtap="sendMessage">
      ➤
    </view>

    <!-- 清空按钮 -->
    <view class="input-btn" wx:if="{{inputText.trim() && !showRecorder}}" bindtap="clearInput">
      ✕
    </view>
  </view>
</view>
