/* pages/profile/company/articles/articles.wxss */
.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 80rpx;
}

/* ==================== 公司基本信息区 ==================== */
.basic-info-section {
  padding: 32rpx;
}

.info-item {
  margin-bottom: 32rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.info-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #2196F3;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.info-input::placeholder {
  color: #CCCCCC;
}

.info-link {
  font-size: 26rpx;
  color: #2196F3;
  font-weight: 500;
  white-space: nowrap;
}

/* ==================== 组织架构区 ==================== */
.organization-section {
  padding: 32rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
  padding-left: 4rpx;
}

.org-list {
  background-color: #F8F8F8;
  border-radius: 12rpx;
  overflow: hidden;
}

.org-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  transition: all 0.3s ease;
}

.org-item:active {
  background-color: #E8E8E8;
}

.org-item:last-child {
  border-bottom: none;
}

.org-text {
  font-size: 28rpx;
  color: #000000;
}

.org-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ==================== 议事规则区 ==================== */
.rules-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  transition: all 0.3s ease;
}

.rules-section:active {
  background-color: #F8F8F8;
}

.rules-title {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

.rules-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background-color: #E5E5E5;
  margin: 0;
}
