<!-- 消息列表组件 -->
<view class="message-list">
  <!-- 消息列表 -->
  <scroll-view 
    scroll-y 
    class="message-scroll" 
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="{{true}}">
    
    <!-- 欢迎消息 -->
    <view wx:if="{{showWelcome}}" class="message-item message-welcome">
      <view class="message-avatar lawyer-avatar">
        <image src="{{welcomeMessage.avatar}}" mode="aspectFill"></image>
      </view>
      <view class="message-content welcome-content">
        <text>{{welcomeMessage.text}}</text>
      </view>
    </view>

    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="id" wx:for-item="msg">
      <!-- 用户消息 -->
      <view wx:if="{{msg.role === 'user'}}" class="message-item message-user" id="msg-{{msg.id}}">
        <view class="message-content user-content">
          <text selectable="{{true}}">{{msg.content}}</text>
          
          <!-- 图片附件 -->
          <image 
            wx:if="{{msg.image}}" 
            class="message-image" 
            src="{{msg.image}}" 
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-url="{{msg.image}}">
          </image>
        </view>
        <view class="message-avatar user-avatar">
          <image src="{{userInfo.avatar}}" mode="aspectFill"></image>
        </view>
      </view>

      <!-- 律师消息 -->
      <view wx:elif="{{msg.role === 'assistant'}}" class="message-item message-lawyer" id="msg-{{msg.id}}">
        <view class="message-avatar lawyer-avatar">
          <image src="{{lawyerInfo.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="message-content lawyer-content">
          <text selectable="{{true}}">{{msg.content}}</text>
          
          <!-- 快捷操作 -->
          <view wx:if="{{msg.actions && msg.actions.length > 0}}" class="message-actions">
            <block wx:for="{{msg.actions}}" wx:key="index" wx:for-item="action">
              <button 
                class="action-button" 
                size="mini" 
                bindtap="onActionClick"
                data-action="{{action}}">
                {{action.label}}
              </button>
            </block>
          </view>

          <!-- 相关信息卡片 -->
          <view wx:if="{{msg.card}}" class="message-card">
            <view class="card-title">{{msg.card.title}}</view>
            <view class="card-content">{{msg.card.content}}</view>
            <view wx:if="{{msg.card.actions}}" class="card-actions">
              <block wx:for="{{msg.card.actions}}" wx:key="index" wx:for-item="action">
                <button 
                  class="card-action-button" 
                  size="mini" 
                  bindtap="onCardActionClick"
                  data-action="{{action}}">
                  {{action.label}}
                </button>
              </block>
            </view>
          </view>
        </view>
      </view>

      <!-- 系统消息 -->
      <view wx:elif="{{msg.role === 'system'}}" class="message-item message-system" id="msg-{{msg.id}}">
        <view class="message-content system-content">
          <text>{{msg.content}}</text>
        </view>
      </view>
    </block>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="message-item message-loading">
      <view class="message-avatar lawyer-avatar">
        <image src="{{lawyerInfo.avatar}}" mode="aspectFill"></image>
      </view>
      <view class="message-content loading-content">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
