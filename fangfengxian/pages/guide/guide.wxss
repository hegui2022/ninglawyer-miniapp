/* pages/guide/guide.wxss */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 80rpx;
}

/* 内容列表区 */
.content-list {
  padding: 24rpx 32rpx;
}

/* 卡片内容 */
.card-content {
  padding: 24rpx 0;
}

.content-item {
  display: flex;
  margin-bottom: 24rpx;
}

.item-number {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
  flex-shrink: 0;
}

.item-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

/* 阅读全文 */
.read-more {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
  margin-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.read-more-text {
  color: #FF6B6B;
  font-size: 28rpx;
  font-weight: bold;
}

/* 收起状态的卡片 */
.collapsed-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.collapsed-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.collapsed-subtitle {
  display: inline-block;
  font-size: 24rpx;
  color: #666666;
  padding: 8rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 20rpx;
}
