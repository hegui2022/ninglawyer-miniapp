<!--pages/manage/manage.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="管理" showBack="{{false}}"></nav-bar>

  <!-- 一键办公区 -->
  <view class="quick-office-section">
    <view class="section-title">一键办公</view>
    <view class="quick-office-list">
      <!-- 会议通知 -->
      <view class="quick-office-item" bindtap="goToQuickOffice" data-type="meeting">
        <view class="quick-office-icon">
          <text>📄</text>
        </view>
        <text class="quick-office-name">会议通知</text>
      </view>

      <!-- 出资协议 -->
      <view class="quick-office-item" bindtap="goToQuickOffice" data-type="agreement">
        <view class="quick-office-icon">
          <text>📝</text>
        </view>
        <text class="quick-office-name">出资协议</text>
      </view>

      <!-- 入股声明 -->
      <view class="quick-office-item" bindtap="goToQuickOffice" data-type="declaration">
        <view class="quick-office-icon">
          <text>📋</text>
        </view>
        <text class="quick-office-name">入股声明</text>
      </view>

      <!-- 上传文件 -->
      <view class="quick-office-item" bindtap="goToQuickOffice" data-type="upload">
        <view class="quick-office-icon">
          <text>📤</text>
        </view>
        <text class="quick-office-name">上传文件</text>
      </view>
    </view>
  </view>

  <!-- 重点部门区 -->
  <view class="department-section">
    <view class="section-title">重点部门</view>
    <view class="department-list">
      <!-- 人力资源部 -->
      <view class="department-card" bindtap="goToDepartment" data-dept="hr">
        <view class="department-icon hr">
          <text class="icon-text">👥</text>
        </view>
        <text class="department-name">人力资源部</text>
      </view>

      <!-- 销售部 -->
      <view class="department-card" bindtap="goToDepartment" data-dept="sales">
        <view class="department-icon sales">
          <text class="icon-text">💼</text>
        </view>
        <text class="department-name">销售部</text>
      </view>

      <!-- 财务部 -->
      <view class="department-card" bindtap="goToDepartment" data-dept="finance">
        <view class="department-icon finance">
          <text class="icon-text">💰</text>
        </view>
        <text class="department-name">财务部</text>
      </view>
    </view>
  </view>

  <!-- 违规举报信 -->
  <view class="report-section" bindtap="goToReport">
    <view class="report-icon">
      <text>💬</text>
    </view>
    <text class="report-text">违规举报信</text>
  </view>

  <!-- 项目审批区 -->
  <view class="approval-section">
    <view class="section-title">项目</view>

    <view class="approval-list">
      <!-- 事假申请 -->
      <view class="approval-item" bindtap="goToApproval" data-type="leave">
        <view class="approval-icon leave">
          <text>📝</text>
        </view>
        <view class="approval-info">
          <text class="approval-name">事假申请</text>
        </view>
        <view class="approval-status pending">
          <text>审批中</text>
        </view>
      </view>

      <view class="approval-divider"></view>

      <!-- 差旅费报销申请 -->
      <view class="approval-item" bindtap="goToApproval" data-type="expense">
        <view class="approval-icon expense">
          <text>✈️</text>
        </view>
        <view class="approval-info">
          <text class="approval-name">差旅费报销申请</text>
        </view>
        <view class="approval-status pending">
          <text>审批中</text>
        </view>
      </view>
    </view>
  </view>

  <!-- TabBar 组件 -->
  <tab-bar currentPath="/pages/manage/manage"></tab-bar>
</view>
