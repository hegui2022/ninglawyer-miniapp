/* 案例详情页面样式 */
.case-detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
  padding: 40rpx 30rpx 60rpx;
  color: white;
}

.back-btn {
  font-size: 32rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* 副标题 */
.subtitle {
  background: white;
  margin: -30rpx 30rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

/* 区块 */
.section {
  background: white;
  margin: 20rpx 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4F46E5;
}

/* 基础信息 */
.info-item {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.label {
  color: #6B7280;
  font-weight: 500;
}

.keywords {
  margin-top: 16rpx;
}

.keyword-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.keyword-tag {
  background: #EEF2FF;
  color: #4F46E5;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 内容文本 */
.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #374151;
  white-space: pre-wrap;
}

/* 争议焦点 */
.focus-list {
  margin-top: 16rpx;
}

.focus-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.focus-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #4F46E5;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.focus-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
  color: #374151;
}

/* 关联法条 */
.law-list {
  margin-top: 16rpx;
}

.law-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.law-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.law-articles {
  font-size: 28rpx;
  color: #6B7280;
}

/* 历审程序 */
.proceeding-list {
  margin-top: 16rpx;
}

.proceeding-item {
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.proceeding-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.procedure-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #4F46E5;
}

.proceeding-date {
  font-size: 24rpx;
  color: #9CA3AF;
}

.proceeding-info {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.info-label {
  font-weight: 500;
  color: #374151;
}
