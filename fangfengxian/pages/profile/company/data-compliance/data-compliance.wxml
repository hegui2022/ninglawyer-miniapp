<!--pages/profile/company/data-compliance/data-compliance.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="数据合规" showBack="{{true}}" bind:back="goBack"></nav-bar>

  <!-- 风险识别模块 -->
  <view class="module-section">
    <!-- 标题栏 -->
    <view class="module-header">
      <view class="header-left">
        <text class="header-icon">🔍</text>
        <text class="header-title">风险识别</text>
      </view>
      <text class="header-link" bindtap="goToList" data-list="risk">风险清单</text>
    </view>

    <!-- 合规义务清单 -->
    <view class="sub-section">
      <view class="sub-title">合规义务清单</view>
      <view class="sub-item" bindtap="goToDetail" data-item="must-comply">
        <text class="item-text">企业必须遵守</text>
        <text class="item-icon">⚡</text>
        <text class="item-arrow">›</text>
      </view>
      <view class="sub-item" bindtap="goToDetail" data-item="promise-comply">
        <text class="item-text">企业承诺遵守</text>
        <text class="item-arrow">›</text>
      </view>
    </view>

    <!-- 权力清单 -->
    <view class="sub-section">
      <view class="sub-title">权力清单</view>
      <view class="sub-item" bindtap="goToDetail" data-item="review-power">
        <text class="item-text">审核权</text>
        <text class="item-icon">⚡</text>
        <text class="item-arrow">›</text>
      </view>
      <view class="sub-item" bindtap="goToDetail" data-item="procurement-power">
        <text class="item-text">采购权</text>
        <text class="item-arrow">›</text>
      </view>
    </view>

    <!-- 流程表 -->
    <view class="sub-section">
      <view class="sub-title">流程表</view>
      <view class="sub-item" bindtap="goToDetail" data-item="data-collection">
        <text class="item-text">数据收集</text>
        <text class="item-arrow">›</text>
      </view>
      <view class="sub-item" bindtap="goToDetail" data-item="procurement-application">
        <text class="item-text">采购申请</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="divider"></view>

  <!-- 管理制度模块 -->
  <view class="module-section">
    <!-- 标题栏 -->
    <view class="module-header">
      <view class="header-left">
        <text class="header-icon">🔍</text>
        <text class="header-title">管理制度</text>
      </view>
      <text class="header-link" bindtap="goToList" data-list="system">制度清单</text>
    </view>

    <!-- 制度列表 -->
    <view class="system-list">
      <view class="system-item" bindtap="goToDetail" data-item="data-security">
        <text class="system-text">数据安全管理制度</text>
      </view>
      <view class="system-item" bindtap="goToDetail" data-item="data-asset">
        <text class="system-text">数据资产管理（分类分级）制度</text>
      </view>
      <view class="system-item" bindtap="goToDetail" data-item="data-incident">
        <text class="system-text">数据安全事件管理制度</text>
      </view>
    </view>
  </view>

  <!-- Home 指示条 -->
  <home-indicator></home-indicator>
</view>
