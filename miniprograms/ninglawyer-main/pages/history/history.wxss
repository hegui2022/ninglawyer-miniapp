.history-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* Tab 切换 */
.tab-bar {
  background: #fff;
  display: flex;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-item text {
  font-size: 28rpx;
  color: #666;
  transition: color 0.3s;
}

.tab-item.active text {
  color: #1890ff;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 24rpx;
}

.filter-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f8f9fa;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.filter-item:last-child {
  margin-right: 0;
}

.filter-item.active {
  background: #e6f7ff;
  color: #1890ff;
  border-color: #1890ff;
}

/* 内容区域 */
.content-container {
  flex: 1;
  padding: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 24rpx 64rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading text {
  font-size: 28rpx;
  color: #999;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.record-tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.record-tag.civil { background: #e6f7ff; color: #1890ff; }
.record-tag.criminal { background: #fff1f0; color: #ff4d4f; }
.record-tag.company { background: #f0f5ff; color: #597ef7; }
.record-tag.labor { background: #f6ffed; color: #52c41a; }
.record-tag.marriage { background: #fff0f6; color: #eb2f96; }
.record-tag.ip { background: #f9f0ff; color: #722ed1; }
.record-tag.contract { background: #fff7e6; color: #fa8c16; }
.record-tag.desensitize { background: #f0f5ff; color: #2f54eb; }

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-content {
  margin-bottom: 24rpx;
}

.record-question {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-answer {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  overflow: hidden;
}

.record-original,
.record-desensitized {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.record-meta {
  display: flex;
  gap: 32rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-hint {
  font-size: 24rpx;
  color: #1890ff;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

/* 加载更多 */
.load-more,
.no-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more text,
.no-more text {
  font-size: 24rpx;
  color: #999;
}
