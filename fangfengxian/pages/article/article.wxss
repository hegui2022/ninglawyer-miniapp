/* pages/article/article.wxss */

.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 34rpx;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

/* ==================== 顶部导航与标题区 ==================== */
.nav-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #FFFFFF;
  padding: 20rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #E5E5E5;
}

/* 返回按钮 */
.back-button {
  position: absolute;
  left: 32rpx;
  top: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #000000;
  font-weight: bold;
}

/* 文章标题 */
.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #000000;
  text-align: center;
  margin: 0 auto;
  padding: 0 80rpx;
  line-height: 1.4;
}

/* 文章标签 */
.article-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  gap: 8rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #4A90E2;
}

.tag-icon {
  font-size: 24rpx;
  color: #4A90E2;
}

/* ==================== 核心内容区 ==================== */
.content-section {
  padding: 32rpx;
}

/* 正文卡片 */
.content-card {
  border: 2rpx solid #4A90E2;
  border-radius: 16rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
}

/* 内容条目 */
.content-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  line-height: 1.8;
}

.content-item:last-child {
  margin-bottom: 0;
}

.item-number {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.item-text {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
  line-height: 1.8;
}

/* 小标题 */
.sub-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #000000;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
}

/* 正文 */
.content-text {
  font-size: 28rpx;
  color: #000000;
  line-height: 1.8;
}

/* 付费提示 */
.pay-prompt {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.pay-text {
  font-size: 32rpx;
  color: #FF5252;
  font-weight: bold;
}

/* ==================== 精选留言区 ==================== */
.comment-section {
  padding: 32rpx;
  margin-top: 32rpx;
  border-top: 1rpx solid #E5E5E5;
}

/* 留言头部 */
.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 28rpx;
  color: #999999;
}

.comment-button {
  font-size: 28rpx;
  color: #4A90E2;
}

/* 留言列表 */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 留言条目 */
.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

/* 留言头像 */
.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5F5F5 0%, #E8E8E8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.comment-avatar.female {
  background: linear-gradient(135deg, #FFB6C1 0%, #FF69B4 100%);
}

.comment-avatar.male {
  background: linear-gradient(135deg, #87CEEB 0%, #4169E1 100%);
}

/* 留言内容包装器 */
.comment-content-wrapper {
  flex: 1;
  padding-top: 8rpx;
}

/* 留言人姓名 */
.comment-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

/* 留言内容 */
.comment-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* ==================== 底部 Home 指示条 ==================== */
.home-indicator {
  position: fixed;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 134rpx;
  height: 5rpx;
  background-color: #000000;
  border-radius: 3rpx;
  margin-bottom: env(safe-area-inset-bottom);
}
