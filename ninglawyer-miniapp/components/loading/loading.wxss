/* 加载组件样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 遮罩层 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
}

/* 尺寸 */
.loading-container.small {
  padding: 20rpx;
}

.loading-container.large {
  padding: 60rpx;
}

/* 圆形加载 */
.loading-circular {
  position: relative;
  width: 60rpx;
  height: 60rpx;
}

.loading-container.small .loading-circular {
  width: 40rpx;
  height: 40rpx;
}

.loading-container.large .loading-circular {
  width: 80rpx;
  height: 80rpx;
}

.circular-path {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 4rpx solid transparent;
  border-top-color: #07C160;
  animation: circular-rotate 1.2s linear infinite;
}

.circular-path:nth-child(1) {
  animation-delay: 0s;
}

.circular-path:nth-child(2) {
  animation-delay: 0.3s;
}

.circular-path:nth-child(3) {
  animation-delay: 0.6s;
}

.circular-path:nth-child(4) {
  animation-delay: 0.9s;
}

@keyframes circular-rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* 点状加载 */
.loading-dots {
  display: flex;
  gap: 16rpx;
}

.loading-container.small .loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
}

.loading-container.large .loading-dots .dot {
  width: 20rpx;
  height: 20rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #07C160;
  border-radius: 50%;
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

.dot:nth-child(3) {
  animation-delay: 0s;
}

@keyframes dot-bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* 条状加载 */
.loading-bar {
  width: 200rpx;
  height: 8rpx;
  background-color: #E0E0E0;
  border-radius: 4rpx;
  overflow: hidden;
}

.loading-container.small .loading-bar {
  width: 150rpx;
  height: 6rpx;
}

.loading-container.large .loading-bar {
  width: 300rpx;
  height: 10rpx;
}

.bar-progress {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #00B050);
  border-radius: 4rpx;
  animation: bar-progress 2s ease-in-out infinite;
}

@keyframes bar-progress {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

/* 文本加载 */
.loading-text {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
}

.loading-container.small .loading-text {
  font-size: 24rpx;
}

.loading-container.large .loading-text {
  font-size: 32rpx;
}

/* 加载消息 */
.loading-message {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #666666;
  text-align: center;
}

.loading-container.small .loading-message {
  font-size: 22rpx;
}

.loading-container.large .loading-message {
  font-size: 30rpx;
}
