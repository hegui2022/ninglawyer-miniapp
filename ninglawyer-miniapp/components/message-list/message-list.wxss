/* 消息列表组件样式 */
.message-list {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
}

.message-scroll {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 32rpx;
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头像 */
.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #E0E0E0;
}

.message-avatar image {
  width: 100%;
  height: 100%;
}

.lawyer-avatar {
  margin-right: 16rpx;
}

.user-avatar {
  margin-left: 16rpx;
}

/* 消息内容 */
.message-content {
  max-width: 560rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

/* 用户消息 */
.message-user {
  flex-direction: row-reverse;
}

.user-content {
  background: linear-gradient(135deg, #07C160, #00B050);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

/* 律师消息 */
.message-lawyer {
  flex-direction: row;
}

.lawyer-content {
  background-color: #ffffff;
  color: #333333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 系统消息 */
.message-system {
  justify-content: center;
}

.system-content {
  background-color: rgba(0, 0, 0, 0.05);
  color: #999999;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  text-align: center;
  max-width: 80%;
}

/* 欢迎消息 */
.message-welcome {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 48rpx;
}

.welcome-content {
  background: linear-gradient(135deg, #07C160, #00B050);
  color: #ffffff;
  padding: 32rpx 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  max-width: 80%;
  font-size: 30rpx;
  line-height: 1.8;
}

/* 消息图片 */
.message-image {
  margin-top: 16rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 12rpx;
  background-color: #F0F0F0;
}

/* 快捷操作 */
.message-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 16rpx;
}

.action-button {
  background-color: #F5F5F5;
  color: #333333;
  border: none;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.action-button::after {
  border: none;
}

/* 信息卡片 */
.message-card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F5F7FA, #E8ECF1);
  border-radius: 16rpx;
  border-left: 6rpx solid #07C160;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.card-action-button {
  background-color: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.card-action-button::after {
  border: none;
}

/* 加载中 */
.message-loading {
  flex-direction: row;
}

.loading-content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #07C160;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}
