/* 合同列表页面样式 */
.record-page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Tab 切换 */
.tabs {
  background: #ffffff;
  display: flex;
  padding: 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  position: relative;
}

.tab-name {
  font-size: 28rpx;
  color: #666666;
  display: block;
}

.tab-count {
  font-size: 20rpx;
  color: #999999;
  margin-left: 8rpx;
}

.tab-item.active .tab-name {
  color: #07C160;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

/* 合同列表 */
.contract-list {
  padding: 24rpx;
}

.contract-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.contract-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.contract-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}

.contract-status {
  font-size: 22rpx;
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.contract-info {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row {
  font-size: 26rpx;
  color: #666666;
  line-height: 2;
}

.info-label {
  color: #999999;
  margin-right: 8rpx;
}

.info-value {
  color: #333333;
}

.contract-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
}

.create-time {
  font-size: 22rpx;
  color: #999999;
}

.view-detail {
  font-size: 24rpx;
  color: #07C160;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  border-radius: 50%;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.btn-create {
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 20rpx 64rpx;
  height: 80rpx;
  line-height: 40rpx;
}
