/* 合同起草页面样式 */
.draft-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 200rpx;
}

/* 表单区块 */
.form-section {
  background: #ffffff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  width: 200rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  min-height: 200rpx;
  padding: 16rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

/* 选择器 */
.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 开关 */
.switch-item {
  justify-content: space-between;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-save {
  background: #F5F5F5;
  color: #666666;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-preview {
  background: #FF9800;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-next {
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
}
