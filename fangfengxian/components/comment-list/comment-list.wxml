<!--components/comment-list/comment-list.wxml-->
<view class="comment-section">
  <!-- 留言头部 -->
  <view class="comment-header">
    <view class="comment-title">{{title || '精选留言'}}</view>
    <view wx:if="{{showButton}}" class="comment-button" bindtap="onComment">
      {{buttonText || '留言'}}
    </view>
  </view>

  <!-- 留言列表 -->
  <view class="comment-list">
    <view class="comment-item" wx:for="{{comments}}" wx:key="id">
      <view class="comment-avatar {{item.gender}}">{{item.avatar}}</view>
      <view class="comment-content-wrapper">
        <view class="comment-name">{{item.name}}</view>
        <view class="comment-text">{{item.content}}</view>
      </view>
    </view>
  </view>
</view>
