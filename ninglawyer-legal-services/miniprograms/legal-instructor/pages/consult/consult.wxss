/* 咨询对话页面样式 - 组件化版本 */
.consult-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
}

/* 快捷问题区域 */
.quick-questions {
  padding: 24rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #E5E5E5;
  flex-shrink: 0;
}

.questions-scroll {
  white-space: nowrap;
}

.question-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #F5F7FA, #E8ECF1);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.4;
  border: 2rpx solid #E0E0E0;
  transition: all 0.3s;
}

.question-item:active {
  background: linear-gradient(135deg, #E8ECF1, #D8DCE1);
  transform: scale(0.95);
}

/* 聊天输入容器 */
.chat-input-container {
  background-color: #ffffff;
  border-top: 1rpx solid #E5E5E5;
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom);
}
