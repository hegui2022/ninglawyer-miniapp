# ============================================
# 宁律师智能法律服务系统 - 环境变量配置
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际环境配置各个参数
# 3. .env 文件已加入 .gitignore，不会提交到代码仓库

# ============================================
# 知识库配置
# ============================================
# 扣子知识库（当前主要知识源）
# 获取方式：扣子平台 -> 知识库 -> 复制知识库ID
COZE_KNOWLEDGE_BASE_ID=your_coze_kb_id_here

# 北大法宝MCP（未来扩展，当前不启用）
# 获取方式：北大法宝MCP平台 -> API密钥
PKULAW_ENABLED=false
PKULAW_MCP_KEY=your_pkulaw_key_here
PKULAW_MCP_URL=https://mcp.pkulaw.com/api/v1

# ============================================
# 模型配置
# ============================================
# 模型选择（可随时切换）
# 可选值：deepseek | zhipu | coze
MODEL_PROVIDER=deepseek

# DeepSeek 配置
# 获取方式：DeepSeek开放平台 -> API密钥
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 智谱配置
# 获取方式：智谱AI开放平台 -> API Key
ZHIPU_API_KEY=your_zhipu_key_here
ZHIPU_MODEL=glm-4

# 扣子配置
# 获取方式：扣子平台 -> 个人中心 -> API Key
COZE_WORKLOAD_IDENTITY_API_KEY=your_coze_key_here
COZE_INTEGRATION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 备用模型配置
# 当主模型调用失败时，自动切换到此模型
FALLBACK_MODEL_PROVIDER=zhipu

# ============================================
# 技能注册配置
# ============================================
# 是否启用自动发现模式
# - true: 开发阶段，自动扫描 skills/ 目录
# - false: 生产阶段，手动注册核心技能
SKILL_AUTO_REGISTER=true

# ============================================
# 存储配置
# ============================================
# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PostgreSQL 配置
DATABASE_URL=postgresql://user:password@localhost/ning_lawyer

# ============================================
# 日志配置
# ============================================
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# 日志目录
LOG_DIR=logs

# ============================================
# 异常处理配置
# ============================================
# 是否启用异常告警
ALERT_ENABLED=false
# 告警Webhook URL（如企业微信机器人）
ALERT_WEBHOOK_URL=your_alert_webhook_url_here

# ============================================
# 应用配置
# ============================================
# 应用名称
APP_NAME=ning_lawyer
# 应用环境：development | staging | production
APP_ENV=development
# 应用端口
APP_PORT=5000
# 调试模式（仅开发环境启用）
DEBUG=true

# ============================================
# 微信小程序配置（可选）
# ============================================
# 获取方式：微信公众平台 -> 开发 -> 开发管理 -> 开发设置
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# ============================================
# 短信服务配置（可选）
# ============================================
# 短信服务商：aliyun | tencent | cloud
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your_sms_access_key_here
SMS_SECRET_KEY=your_sms_secret_key_here
SMS_SIGN_NAME=宁律师
SMS_TEMPLATE_CODE=SMS_123456789

# ============================================
# 其他配置
# ============================================
# 时区
TZ=Asia/Shanghai
# 编码
ENCODING=utf-8
