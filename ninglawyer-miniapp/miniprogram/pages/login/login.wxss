.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1890ff 0%, #ffffff 100%);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.title {
  margin-top: 40rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
}

.content {
  margin-top: 80rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
}

.wechat-btn .wechat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.phone-btn {
  background: #1890ff;
  color: #fff;
  margin-top: 32rpx;
}

.phone-btn[disabled] {
  background: #bfbfbf;
}

.divider {
  margin: 60rpx 0 40rpx 0;
  display: flex;
  align-items: center;
  width: 100%;
}

.divider .line {
  flex: 1;
  height: 1rpx;
  background: #e8e8e8;
}

.divider .text {
  margin: 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

.form {
  width: 100%;
}

.form-item {
  position: relative;
  margin-bottom: 32rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.input:focus {
  border-color: #1890ff;
}

.code-input {
  padding-right: 200rpx;
}

.code-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #1890ff;
  background: transparent;
  border: none;
}

.code-btn[disabled] {
  color: #bfbfbf;
}

.footer {
  margin-top: auto;
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #999;
}

.footer .agreement {
  color: #999;
}

.footer .link {
  color: #1890ff;
  margin: 0 4rpx;
}
