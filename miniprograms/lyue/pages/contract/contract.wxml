<!-- 合同履约页面 -->
<view class="contract-page" wx:if="{{contract}}">
  <!-- 合同基本信息 -->
  <view class="contract-header">
    <text class="contract-title">{{contract.title}}</text>
    <view class="contract-info">
      <text class="info-text">{{contract.partyA.name}} - {{contract.partyB.name}}</text>
      <text class="info-text">期限：{{contract.contractTerm.startDate}} 至 {{contract.contractTerm.endDate}}</text>
    </view>
  </view>
  
  <!-- 履约进度 -->
  <view class="progress-section">
    <view class="section-header">
      <text class="section-title">履约进度</text>
      <text class="section-value">{{performance.passedDays}} / {{performance.totalDays}} 天</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{performance.progress}}%;"></view>
    </view>
    <view class="progress-info">
      <text class="progress-label">已履约</text>
      <text class="progress-percent">{{performance.progress}}%</text>
    </view>
  </view>
  
  <!-- 里程碑 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">履约里程碑</text>
      <text class="section-count">{{milestones.length}}</text>
    </view>
    <view class="milestone-list">
      <view 
        class="milestone-item" 
        wx:for="{{milestones}}" 
        wx:key="id"
        data-milestone="{{item}}"
        bindtap="onMilestoneTap"
      >
        <view class="milestone-icon {{item.status}}">
          <text class="icon-text">{{item.status === 'completed' ? '✓' : '○'}}</text>
        </view>
        <view class="milestone-content">
          <view class="milestone-title">{{item.title}}</view>
          <view class="milestone-desc">{{item.description}}</view>
          <text class="milestone-date">{{item.date}}</text>
        </view>
        <view class="milestone-status" style="color: {{onStatusColor(item.status)}};">
          {{onStatusText(item.status)}}
        </view>
      </view>
    </view>
  </view>
  
  <!-- 提醒设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">履约提醒</text>
      <text class="section-action" bindtap="onEditReminder">设置 ›</text>
    </view>
    <view class="reminder-list">
      <view 
        class="reminder-item" 
        wx:for="{{reminders}}" 
        wx:key="id"
        data-reminder="{{item}}"
        bindtap="onReminderTap"
      >
        <view class="reminder-icon">
          <text class="icon-emoji">{{item.type === 'payment' ? '💰' : item.type === 'insurance' ? '🛡️' : '🔄'}}</text>
        </view>
        <view class="reminder-content">
          <view class="reminder-title">{{item.title}}</view>
          <text class="reminder-schedule">{{item.date}}</text>
          <text class="reminder-next" wx:if="{{item.nextDate}}">下次：{{item.nextDate}}</text>
        </view>
        <view class="reminder-status" style="color: {{onStatusColor(item.status === 'active' ? 'active' : 'pending')}};">
          {{item.status === 'active' ? '已启用' : '待启用'}}
        </view>
      </view>
    </view>
  </view>
  
  <!-- 履约记录 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">履约记录</text>
      <text class="section-action" bindtap="onAddRecord">+ 添加记录</text>
    </view>
    <view class="record-list">
      <view 
        class="record-item" 
        wx:for="{{records}}" 
        wx:key="id"
        data-record="{{item}}"
        bindtap="onRecordTap"
      >
        <view class="record-icon">
          <text class="icon-emoji">{{item.type === 'payment' ? '💰' : item.type === 'insurance' ? '🛡️' : '🎯'}}</text>
        </view>
        <view class="record-content">
          <view class="record-title">{{item.title}}</view>
          <text class="record-date">{{item.date}}</text>
          <text class="record-amount" wx:if="{{item.amount}}">{{item.amount}}</text>
        </view>
        <view class="record-status">
          <text class="status-dot" style="background: {{onStatusColor('completed')}};"></text>
        </view>
      </view>
    </view>
  </view>
</view>
