<!-- 理约 - 履约跟踪 -->
<view class="performance-page">
  <view class="header-section" wx:if="{{contract}}">
    <view class="contract-info">
      <text class="contract-name">{{contract.name}}</text>
      <text class="contract-type">{{contract.type}}</text>
    </view>
    <view class="contract-status status-{{contract.status}}">
      {{contract.status === 'active' ? '履约中' : contract.status === 'completed' ? '已完成' : '已终止'}}
    </view>
  </view>
  
  <view class="timeline-section">
    <view class="section-title">履约时间线</view>
    <view class="timeline-list">
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="id">
        <view class="timeline-dot status-{{item.status}}"></view>
        <view class="timeline-content">
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-date">{{item.date}}</view>
          <view class="timeline-desc">{{item.description}}</view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="obligation-section">
    <view class="section-title">义务履行</view>
    <view class="obligation-list">
      <view class="obligation-item" wx:for="{{obligations}}" wx:key="id">
        <view class="obligation-header">
          <text class="obligation-name">{{item.name}}</text>
          <view class="obligation-badge status-{{item.status}}">
            {{item.status === 'completed' ? '已完成' : item.status === 'pending' ? '待履行' : '已逾期'}}
          </view>
        </view>
        <view class="obligation-meta">
          <text class="obligation-deadline">截止: {{item.deadline}}</text>
          <text class="obligation-party">责任人: {{item.party}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="alert-section" wx:if="{{alerts.length > 0}}">
    <view class="section-title">风险提醒</view>
    <view class="alert-list">
      <view class="alert-item" wx:for="{{alerts}}" wx:key="id">
        <view class="alert-icon">⚠️</view>
        <view class="alert-content">
          <text class="alert-title">{{item.title}}</text>
          <text class="alert-message">{{item.message}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
