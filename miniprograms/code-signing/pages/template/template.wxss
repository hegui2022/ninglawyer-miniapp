/* 合同模板选择页面样式 */
.template-page {
  min-height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 搜索框 */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ffffff;
  padding: 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 0 72rpx 0 24rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 48rpx;
  font-size: 32rpx;
  color: #999999;
}

/* 分类标签 */
.category-tabs {
  white-space: nowrap;
  background: #ffffff;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  margin-right: 16rpx;
}

.tab-item.active {
  background: #07C160;
}

.tab-text {
  font-size: 26rpx;
  color: #333333;
}

.tab-item.active .tab-text {
  color: #ffffff;
}

/* 模板列表 */
.template-list {
  flex: 1;
  padding: 0 24rpx 24rpx;
}

.template-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.template-icon {
  width: 96rpx;
  height: 96rpx;
  background: #E8F5E9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.template-info {
  flex: 1;
}

.template-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.template-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
  display: block;
  line-height: 1.5;
}

.template-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #07C160;
}

.template-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
