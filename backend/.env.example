# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/legal_assistant

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 扣子API配置
COZE_API_KEY=your_coze_api_key_here
COZE_API_BASE_URL=https://api.coze.cn

# 扣子SKILL技能配置（新增）
# SKILL API Base URL（调用SKILL的基础URL）
COZE_SKILL_API_BASE_URL=https://api.coze.com/v1

# SKILL API Key（调用SKILL的认证密钥）
COZE_SKILL_API_KEY=your_coze_skill_api_key_here

# SKILL ID列表（各个法律领域对应的SKILL ID）
COZE_SKILL_CIVIL_ID=your_civil_skill_id_here              # 民事咨询SKILL ID
COZE_SKILL_CRIMINAL_ID=your_criminal_skill_id_here        # 刑事咨询SKILL ID
COZE_SKILL_COMPANY_ID=your_company_skill_id_here          # 公司法务SKILL ID
COZE_SKILL_LABOR_ID=your_labor_skill_id_here              # 劳动纠纷SKILL ID
COZE_SKILL_MARRIAGE_ID=your_marriage_skill_id_here        # 婚姻家庭SKILL ID
COZE_SKILL_IP_ID=your_ip_skill_id_here                    # 知识产权SKILL ID
COZE_SKILL_CONTRACT_DRAFT_ID=your_contract_draft_id_here  # 合同起草SKILL ID
COZE_SKILL_CONTRACT_REVIEW_ID=your_contract_review_id_here # 合同审查SKILL ID
COZE_SKILL_DESENSITIZE_ID=your_desensitize_id_here        # 信息脱敏SKILL ID

# SKILL API超时设置（秒）
COZE_SKILL_TIMEOUT=300

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 短信服务配置（用于发送验证码）
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=your_sms_sign_name
SMS_TEMPLATE_CODE=your_sms_template_code

# JWT配置
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=604800

# Flask配置
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 对象存储配置（如果需要）
OSS_ENDPOINT=your_oss_endpoint
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=your_oss_bucket_name
