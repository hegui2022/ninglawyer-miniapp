/* 判例查询页面样式 */
.cases-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
}

/* 搜索栏 */
.search-bar {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-btn {
  font-size: 28rpx;
  color: #07C160;
  font-weight: 600;
  padding: 8rpx 24rpx;
}

/* 案例列表 */
.case-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.case-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.case-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.case-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.case-court,
.case-no {
  font-size: 24rpx;
  color: #666666;
}

.case-result {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.result-label {
  color: #999999;
  font-weight: 600;
}

.result-value {
  color: #07C160;
  font-weight: 600;
}

.case-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-item {
  padding: 8rpx 20rpx;
  background: #E8F5E9;
  color: #07C160;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.case-date {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #CCCCCC;
}
