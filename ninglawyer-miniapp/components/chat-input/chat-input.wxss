/* 输入框组件样式 */
.input-container {
  width: 100%;
  background-color: #ffffff;
  border-top: 1rpx solid #E5E5E5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 图片预览 */
.image-preview {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #F5F5F5;
}

.preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #E0E0E0;
}

.image-close {
  width: 48rpx;
  height: 48rpx;
  margin-left: 16rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}

/* 输入框区域 */
.input-box {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

/* 图标按钮 */
.icon-button {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #F5F5F5;
  flex-shrink: 0;
  transition: all 0.3s;
}

.icon-button:active {
  background-color: #E0E0E0;
  transform: scale(0.95);
}

.icon-button image {
  width: 40rpx;
  height: 40rpx;
}

/* 文本输入框包装器 */
.text-input-wrapper {
  flex: 1;
  background-color: #F5F5F5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  min-height: 64rpx;
  max-height: 200rpx;
  overflow-y: auto;
  transition: all 0.3s;
}

.text-input-wrapper:focus-within {
  background-color: #ffffff;
  border: 2rpx solid #07C160;
}

/* 文本输入框 */
.text-input {
  width: 100%;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  min-height: 40rpx;
}

.placeholder {
  color: #999999;
}

/* 发送按钮 */
.send-button {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #E0E0E0;
  flex-shrink: 0;
  transition: all 0.3s;
  opacity: 0.5;
}

.send-button.active {
  background: linear-gradient(135deg, #07C160, #00B050);
  opacity: 1;
}

.send-button:active {
  transform: scale(0.95);
}

.send-button image {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

.send-button.active image {
  filter: brightness(0) invert(1);
}
