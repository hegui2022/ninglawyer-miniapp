/* 防风险详情页样式 */
.detail-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.risk-header {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.risk-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}

.risk-level {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.risk-high {
  background: #FFEBEE;
  color: #F44336;
}

.risk-medium {
  background: #FFF3E0;
  color: #FF9800;
}

.risk-low {
  background: #E8F5E9;
  color: #4CAF50;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.section-content {
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.text-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.suggestion-icon {
  width: 48rpx;
  height: 48rpx;
  background: #07C160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.icon-check {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

.suggestion-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.suggestion-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.btn-implement {
  align-self: flex-start;
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
}
