/* pages/template-list/template-list.wxss */

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.filter-item {
  padding: 15rpx 30rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.3s;
}

.filter-item.active {
  background: #4A90E2;
  color: #FFFFFF;
}

.template-list {
  padding: 20rpx;
}

.template-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.template-item:active {
  transform: scale(0.98);
}

.template-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.template-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.template-title-group {
  flex: 1;
}

.template-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.template-type {
  font-size: 22rpx;
  color: #4A90E2;
  background: #E6F7FF;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  display: inline-block;
}

.template-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.template-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.template-meta {
  display: flex;
  align-items: center;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #999999;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}
