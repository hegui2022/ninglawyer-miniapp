<view class="history-container">
  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'consultation' ? 'active' : ''}}" 
      bindtap="switchTab"
      data-tab="consultation"
    >
      <text>咨询记录</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'consultation'}}"></view>
    </view>
    <view 
      class="tab-item {{activeTab === 'contract' ? 'active' : ''}}" 
      bindtap="switchTab"
      data-tab="contract"
    >
      <text>合同记录</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'contract'}}"></view>
    </view>
    <view 
      class="tab-item {{activeTab === 'desensitize' ? 'active' : ''}}" 
      bindtap="switchTab"
      data-tab="desensitize"
    >
      <text>脱敏记录</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'desensitize'}}"></view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <scroll-view class="filter-scroll" scroll-x wx:if="{{activeTab === 'consultation'}}">
      <view class="filter-list">
        <view 
          class="filter-item {{selectedDomain === item.id ? 'active' : ''}}" 
          wx:for="{{domains}}" 
          wx:key="id"
          bindtap="filterByDomain"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 列表内容 -->
  <scroll-view 
    class="content-container" 
    scroll-y 
    bindscrolltolower="loadMore"
  >
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
      <image class="empty-icon" src="/static/icons/empty.png"></image>
      <text class="empty-text">暂无记录</text>
      <button class="empty-btn" bindtap="goToCreate">去咨询</button>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading && records.length === 0}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 咨询记录列表 -->
    <view class="record-list" wx:if="{{activeTab === 'consultation'}}">
      <view 
        class="record-item" 
        wx:for="{{records}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
        data-type="consultation"
      >
        <view class="record-header">
          <view class="record-tag {{item.domain}}">
            {{item.domainName}}
          </view>
          <text class="record-time">{{item.time}}</text>
        </view>
        <view class="record-content">
          <text class="record-question">{{item.question}}</text>
          <text class="record-answer">{{item.answer}}</text>
        </view>
        <view class="record-footer">
          <text class="record-hint">点击查看详情</text>
          <image class="arrow-icon" src="/static/icons/arrow-right.png"></image>
        </view>
      </view>
    </view>

    <!-- 合同记录列表 -->
    <view class="record-list" wx:if="{{activeTab === 'contract'}}">
      <view 
        class="record-item" 
        wx:for="{{records}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
        data-type="contract"
      >
        <view class="record-header">
          <view class="record-tag contract">
            {{item.contractType}}
          </view>
          <text class="record-time">{{item.time}}</text>
        </view>
        <view class="record-content">
          <text class="record-title">{{item.title}}</text>
          <view class="record-meta">
            <text class="meta-item">评分: {{item.score}}分</text>
            <text class="meta-item">风险: {{item.riskCount}}项</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 脱敏记录列表 -->
    <view class="record-list" wx:if="{{activeTab === 'desensitize'}}">
      <view 
        class="record-item" 
        wx:for="{{records}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
        data-type="desensitize"
      >
        <view class="record-header">
          <view class="record-tag desensitize">
            脱敏
          </view>
          <text class="record-time">{{item.time}}</text>
        </view>
        <view class="record-content">
          <text class="record-original">原文: {{item.original}}</text>
          <text class="record-desensitized">脱敏: {{item.desensitized}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && records.length > 0}}">
      <text>{{loadingMore ? '加载中...' : '下拉加载更多'}}</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
      <text>没有更多记录了</text>
    </view>
  </scroll-view>
</view>
