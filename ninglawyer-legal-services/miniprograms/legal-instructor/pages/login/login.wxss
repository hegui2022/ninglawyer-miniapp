/* 登录页面样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #ffffff;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.app-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 表单区域 */
.form-section {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 32rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 96rpx;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  background: transparent;
}

.input-field::placeholder {
  color: #CCCCCC;
}

.code-wrapper {
  padding-right: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  padding: 0 24rpx;
  height: 64rpx;
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 32rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.code-btn.disabled {
  background: #CCCCCC;
  color: #999999;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: #CCCCCC;
  color: #999999;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

.login-btn.active {
  background: #07C160;
  color: #ffffff;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #E0E0E0;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 微信登录 */
.wechat-btn {
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  color: #07C160;
  border: 2rpx solid #07C160;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 协议区域 */
.agreement-section {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.agreement-text {
  color: rgba(255, 255, 255, 0.8);
}

.agreement-link {
  color: #ffffff;
  font-weight: 600;
}
