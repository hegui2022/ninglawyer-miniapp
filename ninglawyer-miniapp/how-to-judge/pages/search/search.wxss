/* 怎么判 - 案例搜索样式 */
.search-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-btn {
  height: 64rpx;
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 32rpx;
}

.filter-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  margin-bottom: 24rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999999;
}

.result-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-header {
  margin-bottom: 24rpx;
}

.result-count {
  font-size: 28rpx;
  color: #666666;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-item {
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.result-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-tag {
  font-size: 24rpx;
  color: #07C160;
  background: #E8F5E9;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.result-date {
  font-size: 24rpx;
  color: #999999;
}

.result-summary {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: block;
}

.result-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.keyword-tag {
  font-size: 24rpx;
  color: #07C160;
  background: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #F5F5F5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}
