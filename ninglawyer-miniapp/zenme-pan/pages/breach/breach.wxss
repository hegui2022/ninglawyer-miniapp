/* 违约判断页面样式 */
.breach-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* 表单区域 */
.form-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333333;
  padding: 20rpx 0;
}

.form-input {
  font-size: 28rpx;
  color: #333333;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.form-textarea {
  font-size: 28rpx;
  color: #333333;
  min-height: 200rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  line-height: 1.8;
}

.char-count {
  font-size: 22rpx;
  color: #999999;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

.form-tips {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 32rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #F57C00;
  line-height: 1.6;
  flex: 1;
}

.btn-analyze {
  background: #07C160;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 32rpx;
}

.btn-analyze[disabled] {
  background: #CCCCCC;
}

/* 结果区域 */
.result-section {
  padding-bottom: 32rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.result-confidence {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
  background: #E8F5E9;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.result-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.title-icon {
  font-size: 48rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.card-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 2;
  margin-bottom: 16rpx;
}

.content-label {
  color: #999999;
  margin-right: 8rpx;
}

.content-value {
  color: #333333;
}

.card-header-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 24rpx;
}

/* 法律依据 */
.law-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.law-item {
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.law-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #07C160;
  display: block;
  margin-bottom: 12rpx;
}

.law-content {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.8;
}

/* 救济措施 */
.remedy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.remedy-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.remedy-dot {
  font-size: 32rpx;
  color: #07C160;
  flex-shrink: 0;
}

.remedy-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

/* 证据建议 */
.evidence-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.evidence-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.evidence-icon {
  font-size: 28rpx;
}

.evidence-text {
  font-size: 24rpx;
  color: #333333;
}

/* 维权建议 */
.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommendation-item {
  display: flex;
  gap: 12rpx;
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.rec-number {
  font-size: 26rpx;
  font-weight: 700;
  color: #07C160;
  flex-shrink: 0;
}

.rec-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

/* 操作按钮 */
.result-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  padding-top: 24rpx;
}

.btn-reset,
.btn-rights,
.btn-cases {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.btn-reset {
  background: #F5F5F5;
  color: #666666;
  border: none;
}

.btn-rights {
  background: #2196F3;
  color: #ffffff;
  border: none;
}

.btn-cases {
  background: #FF9800;
  color: #ffffff;
  border: none;
}
