/* pages/profile/company/company.wxss */
.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 80rpx;
}

/* ==================== 顶部横幅轮播图 ==================== */
.banner-section {
  width: 100%;
  height: 320rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  font-size: 120rpx;
  opacity: 0.3;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.banner-title {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: bold;
  z-index: 1;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* ==================== 合规分类区 ==================== */
.compliance-section {
  padding: 0 32rpx;
}

.category-header {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.category-header.no-arrow {
  padding: 32rpx 0;
}

.category-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.category-title {
  flex: 1;
  font-size: 32rpx;
  color: #2196F3;
  font-weight: 500;
}

.category-title.single-item {
  color: #2196F3;
}

.category-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
  margin-left: 8rpx;
}

/* 分类列表 */
.category-list {
  padding-left: 64rpx;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.category-list.collapsed {
  max-height: 0;
}

.category-list.expanded {
  max-height: 500rpx;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.category-item:last-child {
  border-bottom: none;
}

.item-text {
  font-size: 28rpx;
  color: #333333;
}

.item-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 0 32rpx;
}

/* ==================== 其他功能列表 ==================== */
.function-section {
  padding: 0 32rpx;
}

.function-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
}

.function-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* ==================== 悬浮功能按钮 ==================== */
.fab-button {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 100;
}

.fab-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.4);
  font-size: 48rpx;
}

.fab-text {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}
