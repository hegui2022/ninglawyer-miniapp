/* 怎么判小程序 - 首页样式 */
.index-page {
  min-height: 100vh;
  padding: 24rpx;
}

/* 搜索框 */
.search-bar {
  padding: 24rpx 0;
}

.search-input {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: var(--white);
  border-radius: var(--radius-xl);
  padding: 0 32rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-placeholder);
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
  background: var(--primary-light);
  border-radius: var(--radius-lg);
  padding: 20rpx;
}

.action-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 分类网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.category-item {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}

.category-name {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.category-count {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* 案例列表 */
.case-list {
  display: flex;
  flex-direction: column;
}

.case-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.case-item:last-child {
  border-bottom: none;
}

.case-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.case-title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.case-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.case-tag {
  font-size: 22rpx;
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.case-date {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.case-result {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 24rpx;
}

.result-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.result-text {
  font-size: 26rpx;
  color: var(--success-color);
  font-weight: 600;
}

/* 最近列表 */
.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.recent-title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.recent-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recent-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
}

.recent-icon image {
  width: 100%;
  height: 100%;
}
