<!--pages/guide/article/article.wxml-->
<view class="container">
  <!-- 顶部导航栏组件 -->
  <nav-bar title="网络及数据安全技术措施" showBack="{{true}}" bind:back="goBack"></nav-bar>

  <!-- 文章信息区 -->
  <view class="article-info">
    <view class="article-tag">
      <text class="tag-text">网络安</text>
      <text class="tag-icon">✏️</text>
    </view>
  </view>

  <!-- 核心内容区 -->
  <view class="content-section">
    <!-- 正文卡片组件 -->
    <content-card>
      <!-- 三条技术措施说明 -->
      <view class="content-item">
        <text class="item-number">1、</text>
        <text class="item-text">公司采取了防范计算机病毒和网络攻击、网络侵入等危害网络安全行为的技术措施，如公司部界了专业防火墙、办公桌面安装了杀毒软件；</text>
      </view>

      <view class="content-item">
        <text class="item-number">2、</text>
        <text class="item-text">公司采取了监测、记录网络运行状态、网络安全事件的技术措施，如公司部署的防火墙具备网络异常监测和运行日志功能；</text>
      </view>

      <view class="content-item">
        <text class="item-number">3、</text>
        <text class="item-text">公司采取了备份、加密、访问控制等必要措施，保障数据免遭泄密、窃取、篡改、毁损、丢失。</text>
      </view>

      <!-- 小标题 -->
      <view class="sub-title">(四) 网络安全等级保护</view>

      <!-- 正文 -->
      <view class="content-text">{{hasPaid ? fullContent : partialContent}}</view>
    </content-card>

    <!-- 付费提示 -->
    <view wx:if="{{!hasPaid}}" class="pay-prompt" bindtap="handlePay">
      <text class="pay-text">付费20元</text>
    </view>
  </view>

  <!-- 精选留言区组件 -->
  <comment-list
    comments="{{comments}}"
    showButton="{{true}}"
    buttonText="留言"
    bind:comment="handleComment"
  ></comment-list>

  <!-- Home 指示条组件 -->
  <home-indicator></home-indicator>
</view>
