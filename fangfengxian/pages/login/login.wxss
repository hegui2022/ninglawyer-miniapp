/* pages/login/login.wxss */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-top: var(--status-bar-height);
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 44rpx;
  padding: 0 32rpx;
  background-color: #FFFFFF;
}

.status-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-center {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

.status-right {
  display: flex;
  align-items: center;
}

.status-icon {
  width: 36rpx;
  height: 36rpx;
  font-size: 32rpx;
  line-height: 1;
}

/* 核心品牌区 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}

.brand-icon {
  width: 160rpx;
  height: 160rpx;
  font-size: 140rpx;
  line-height: 1;
  margin-bottom: 40rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(74, 144, 226, 0.2));
}

.brand-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #000000;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.brand-desc {
  font-size: 28rpx;
  color: #999999;
  letter-spacing: 2rpx;
}

/* 登录按钮区 */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 280rpx;
  gap: 48rpx;
}

.btn {
  width: 580rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s;
  box-sizing: border-box;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.2);
}

.link-text {
  font-size: 28rpx;
  color: #4A90E2;
  letter-spacing: 2rpx;
}
