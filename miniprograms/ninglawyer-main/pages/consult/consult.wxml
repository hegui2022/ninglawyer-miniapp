<!--pages/consult/consult.wxml-->
<view class="container">
  <view class="page-title">⚖️ 法律咨询</view>
  <view class="page-desc">专业的民事法律咨询服务</view>

  <!-- 输入区域 -->
  <view class="input-section">
    <textarea
      class="question-input"
      placeholder="请描述您的法律问题，例如：合同违约了怎么办？"
      value="{{question}}"
      bindinput="onQuestionInput"
      maxlength="500"
      auto-height
    />
    <view class="input-actions">
      <button class="btn-clear" bindtap="onClear">清空</button>
      <button class="btn-submit" bindtap="onConsult" loading="{{loading}}">
        {{loading ? '咨询中...' : '提交咨询'}}
      </button>
    </view>
  </view>

  <!-- 结果展示 -->
  <view class="result-section" wx:if="{{result}}">
    <view class="result-header">
      <text class="result-title">咨询结果</text>
      <button class="btn-copy-mini" bindtap="onCopyAnswer" data-answer="{{result}}">复制</button>
    </view>
    <view class="result-content">
      <text class="result-text">{{result}}</text>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="history-section" wx:if="{{history.length > 0}}">
    <view class="history-title">咨询历史</view>
    <view class="history-list">
      <view
        class="history-item"
        wx:for="{{history}}"
        wx:key="time"
      >
        <view class="history-question">
          <text class="history-label">问：</text>
          <text class="history-text">{{item.question}}</text>
        </view>
        <view class="history-answer">
          <text class="history-label">答：</text>
          <text class="history-text">{{item.answer}}</text>
        </view>
        <view class="history-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 快捷问题 -->
  <view class="quick-questions">
    <view class="quick-title">常见问题</view>
    <view class="quick-list">
      <view class="quick-item" bindtap="onQuickQuestion" data-question="合同违约了怎么办？">
        合同违约了怎么办？
      </view>
      <view class="quick-item" bindtap="onQuickQuestion" data-question="想离婚，财产怎么分？">
        想离婚，财产怎么分？
      </view>
      <view class="quick-item" bindtap="onQuickQuestion" data-question="工资被拖欠怎么办？">
        工资被拖欠怎么办？
      </view>
      <view class="quick-item" bindtap="onQuickQuestion" data-question="房屋漏水谁负责？">
        房屋漏水谁负责？
      </view>
    </view>
  </view>
</view>
