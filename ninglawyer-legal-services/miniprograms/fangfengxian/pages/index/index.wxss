/* pages/index/index.wxss */

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #07C160 0%, #06A850 100%);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.user-details {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 24rpx;
  opacity: 0.9;
}

.risk-badge {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  background-color: rgba(255, 255, 255, 0.2);
}

.risk-level-text {
  font-weight: bold;
}

/* 风险概览 */
.risk-overview {
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.card-more {
  font-size: 24rpx;
  color: #07C160;
}

.risk-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
}

/* 快捷功能 */
.quick-actions {
  margin-bottom: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333333;
}

/* 最近扫描 */
.recent-scan {
  margin-bottom: 24rpx;
}

.scan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.scan-item:last-child {
  border-bottom: none;
}

.scan-info {
  display: flex;
  flex-direction: column;
}

.scan-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.scan-time {
  font-size: 24rpx;
  color: #999999;
}

.scan-badge {
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

/* 风险提示 */
.risk-tips {
  margin-bottom: 24rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tip-item:last-child {
  border-bottom: none;
}

.tip-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.tip-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

/* 扫描按钮 */
.scan-btn-container {
  padding: 24rpx 0;
}
