<!-- 理约 - 合同列表 -->
<view class="list-page">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{filterType === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-type="all">全部</view>
    <view class="filter-item {{filterType === 'active' ? 'active' : ''}}" bindtap="onFilterChange" data-type="active">生效中</view>
    <view class="filter-item {{filterType === 'completed' ? 'active' : ''}}" bindtap="onFilterChange" data-type="completed">已完成</view>
  </view>
  
  <!-- 合同列表 -->
  <view class="contract-list">
    <view class="contract-card" wx:for="{{contractList}}" wx:key="id" bindtap="onContractDetail" data-id="{{item.id}}">
      <view class="contract-header">
        <text class="contract-title">{{item.title}}</text>
        <view class="contract-tag">{{item.statusText}}</view>
      </view>
      <view class="contract-body">
        <text class="contract-info">合同编号：{{item.contractNo}}</text>
        <text class="contract-info">签署日期：{{item.signDate}}</text>
        <text class="contract-info">到期日期：{{item.expiryDate}}</text>
      </view>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && loading}}">
    <text>加载中...</text>
  </view>
</view>
