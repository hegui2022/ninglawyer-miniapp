/* pages/department/department.wxss */
.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 120rpx;
}

/* ==================== 功能标签区 ==================== */
.tab-section {
  padding: 24rpx 32rpx;
}

.tab-list {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item {
  padding: 8rpx 16rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  color: #000000;
  font-weight: bold;
}

.tab-divider {
  margin: 0 16rpx;
  color: #E5E5E5;
  font-size: 24rpx;
}

/* ==================== 岗位列表区 ==================== */
.position-section {
  padding: 16rpx 0;
}

.position-scroll {
  width: 100%;
}

.position-list {
  display: flex;
  flex-direction: row;
  padding: 0 32rpx;
  gap: 32rpx;
}

.position-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.position-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  background-color: #F5F5F5;
  font-size: 48rpx;
}

.position-avatar.female {
  background-color: #FFE4E1;
}

.position-avatar.male {
  background-color: #E1F5FE;
}

.position-avatar.animal {
  background-color: #FFF3E0;
}

.avatar-icon {
  font-size: 48rpx;
}

.position-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* ==================== 时间戳 ==================== */
.timestamp-section {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.timestamp {
  font-size: 22rpx;
  color: #999999;
}

/* ==================== 聊天消息区 ==================== */
.chat-section {
  padding: 24rpx 32rpx;
}

.message-card {
  display: flex;
  flex-direction: column;
  max-width: 600rpx;
  margin: 0 auto;
}

.message-source {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.source-avatar {
  width: 48rpx;
  height: 48rpx;
  background-color: #E3F2FD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
}

.source-text {
  font-size: 24rpx;
  color: #666666;
}

.message-bubble {
  background-color: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  position: relative;
}

.message-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 审批印章 */
.approval-stamp {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-15deg);
  border: 4rpx solid #FF5252;
  border-radius: 16rpx;
  padding: 16rpx 32rpx;
  background-color: rgba(255, 82, 82, 0.1);
}

.stamp-text {
  font-size: 32rpx;
  color: #FF5252;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.approver-info {
  display: flex;
  justify-content: flex-end;
  padding-top: 8rpx;
}

.approver-text {
  font-size: 22rpx;
  color: #999999;
}

/* ==================== 底部聊天工具栏 ==================== */
.chat-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E5E5E5;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.voice-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.text-input {
  flex: 1;
  height: 64rpx;
  background-color: #F5F5F5;
  border-radius: 32rpx;
  padding: 0 24rpx;
}

.text-input input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
}

.voice-input {
  flex: 1;
  height: 64rpx;
  background-color: #F5F5F5;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
}

.voice-input:active {
  background-color: #E8E8E8;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.add-btn:active {
  background-color: #43A047;
}

/* ==================== 功能面板 ==================== */
.function-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 0;
  z-index: 200;
  transition: height 0.3s ease;
  overflow: hidden;
}

.function-panel.show {
  height: 600rpx;
}

.panel-mask {
  position: absolute;
  top: -100vh;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.panel-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E5E5E5;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.menu-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background-color: #F5F5F5;
  border-radius: 32rpx;
  padding: 0 24rpx;
}

.search-input input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
}

.panel-add-btn {
  width: 64rpx;
  height: 64rpx;
  background-color: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* 快捷功能按钮 */
.quick-functions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx 24rpx;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.function-icon {
  width: 96rpx;
  height: 96rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 48rpx;
}

.function-text {
  font-size: 22rpx;
  color: #666666;
}
