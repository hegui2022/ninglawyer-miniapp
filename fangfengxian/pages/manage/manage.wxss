/* pages/manage/manage.wxss */
.container {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 160rpx;
}

/* ==================== 通用样式 ==================== */
.section-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* ==================== 一键办公区 ==================== */
.quick-office-section {
  padding: 32rpx;
}

.quick-office-list {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.quick-office-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.quick-office-icon {
  width: 96rpx;
  height: 96rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 48rpx;
  transition: all 0.3s ease;
}

.quick-office-item:active .quick-office-icon {
  background-color: #E8E8E8;
  transform: scale(0.95);
}

.quick-office-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* ==================== 重点部门区 ==================== */
.department-section {
  padding: 0 32rpx 32rpx;
}

.department-list {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.department-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
}

.department-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 56rpx;
}

.icon-text {
  font-size: 56rpx;
}

/* 不同部门的颜色 */
.department-icon.hr {
  background-color: #E8F5E9;
}

.department-icon.sales {
  background-color: #FFEBEE;
}

.department-icon.finance {
  background-color: #E3F2FD;
}

.department-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

/* ==================== 违规举报信 ==================== */
.report-section {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx;
  padding: 24rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.report-section:active {
  background-color: #E8E8E8;
  transform: scale(0.98);
}

.report-icon {
  width: 64rpx;
  height: 64rpx;
  background-color: #FFEBEE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.report-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* ==================== 项目审批区 ==================== */
.approval-section {
  padding: 0 32rpx 32rpx;
}

.approval-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
}

.approval-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  transition: all 0.3s ease;
}

.approval-item:active {
  background-color: #F8F8F8;
}

.approval-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 40rpx;
  flex-shrink: 0;
}

.approval-icon.leave {
  background-color: #E8F5E9;
}

.approval-icon.expense {
  background-color: #E3F2FD;
}

.approval-info {
  flex: 1;
}

.approval-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.approval-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.approval-status.pending {
  background-color: #FFEBEE;
  color: #FF5252;
}

/* 审批列表虚线分隔 */
.approval-divider {
  height: 1rpx;
  background-image: linear-gradient(to right, #E5E5E5 50%, transparent 50%);
  background-size: 16rpx 1rpx;
  background-repeat: repeat-x;
}
