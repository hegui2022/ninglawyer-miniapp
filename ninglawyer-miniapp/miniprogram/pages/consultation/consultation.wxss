.consultation-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 法律领域选择 */
.domain-section {
  background: #fff;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.domain-scroll {
  white-space: nowrap;
}

.domain-list {
  display: inline-flex;
  padding: 0 24rpx;
}

.domain-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.domain-item:last-child {
  margin-right: 0;
}

.domain-item.active {
  background: #1890ff;
}

.domain-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
}

.domain-name {
  font-size: 24rpx;
  color: #666;
}

.domain-item.active .domain-name {
  color: #fff;
}

/* 聊天区域 */
.chat-container {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 80rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #bfbfbf;
}

/* 消息列表 */
.message-list {
  padding-bottom: 24rpx;
}

.message-item {
  display: flex;
  margin-bottom: 32rpx;
  animation: fadeIn 0.3s ease-in;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-content {
  max-width: 60%;
  padding: 24rpx;
  border-radius: 16rpx;
  position: relative;
}

.message-item.user .message-content {
  background: #1890ff;
  color: #fff;
  margin-right: 16rpx;
}

.message-item.assistant .message-content {
  background: #fff;
  color: #333;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.message-time {
  display: block;
  font-size: 20rpx;
  opacity: 0.6;
  margin-top: 8rpx;
}

.message-actions {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
}

.action-btn {
  font-size: 24rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 8rpx;
}

/* 加载动画 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #999;
  animation: typing 1.4s infinite;
}

.dot:nth-child(1) {
  animation-delay: 0s;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-8rpx);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 输入区域 */
.input-section {
  background: #fff;
  padding: 24rpx;
  border-top: 1rpx solid #e8e8e8;
}

.input-container {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.input-wrapper {
  flex: 1;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 16rpx;
}

.input-field {
  width: 100%;
  min-height: 80rpx;
  max-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
  border: none;
  background: transparent;
}

.send-btn {
  width: 88rpx;
  height: 88rpx;
  background: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.send-btn[disabled] {
  background: #bfbfbf;
}

.send-icon {
  width: 40rpx;
  height: 40rpx;
}

.input-tips {
  margin-top: 12rpx;
  text-align: center;
}

.input-tips text {
  font-size: 22rpx;
  color: #bfbfbf;
}
