<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部欢迎 -->
  <view class="header">
    <view class="header-content">
      <text class="header-title">👋 你好，我是宁律师</text>
      <text class="header-subtitle">智能法律咨询，随时为你服务</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="features">
    <view class="feature-card" bindtap="goToDraft">
      <view class="feature-icon">📝</view>
      <text class="feature-title">起草合同</text>
      <text class="feature-desc">快速生成各类合同</text>
    </view>

    <view class="feature-card" bindtap="goToReview">
      <view class="feature-icon">🔍</view>
      <text class="feature-title">审查合同</text>
      <text class="feature-desc">智能识别风险点</text>
    </view>

    <view class="feature-card" bindtap="goToList">
      <view class="feature-icon">📋</view>
      <text class="feature-title">合同管理</text>
      <text class="feature-desc">查看和管理合同</text>
    </view>

    <view class="feature-card" bindtap="goToConsult">
      <view class="feature-icon">💬</view>
      <text class="feature-title">法律咨询</text>
      <text class="feature-desc">专业法律建议</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-access">
    <view class="section-title">快捷入口</view>
    
    <view class="quick-item" bindtap="quickCreateContract('standard')">
      <text class="quick-icon">💼</text>
      <text class="quick-text">劳动合同</text>
      <text class="quick-arrow">›</text>
    </view>

    <view class="quick-item" bindtap="quickCreateContract('parttime')">
      <text class="quick-icon">⏰</text>
      <text class="quick-text">非全日制合同</text>
      <text class="quick-arrow">›</text>
    </view>

    <view class="quick-item" bindtap="quickCreateContract('intern')">
      <text class="quick-icon">🎓</text>
      <text class="quick-text">实习协议</text>
      <text class="quick-arrow">›</text>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tips">
    <text class="tips-text">💡 智能提示：本服务仅供参考，不构成正式法律意见。复杂问题建议咨询专业律师。</text>
  </view>
</view>
