<!--pages/report/report.wxml-->
<view class="container">
  <!-- 报告头部 -->
  <view class="card report-header">
    <view class="header-title">
      <text class="title-text">风险分析报告</text>
      <text class="title-date">{{reportDate}}</text>
    </view>
    <view class="header-summary">
      <view class="summary-item">
        <text class="summary-value risk-high">{{summary.high}}</text>
        <text class="summary-label">高风险</text>
      </view>
      <view class="summary-item">
        <text class="summary-value risk-medium">{{summary.medium}}</text>
        <text class="summary-label">中风险</text>
      </view>
      <view class="summary-item">
        <text class="summary-value risk-low">{{summary.low}}</text>
        <text class="summary-label">低风险</text>
      </view>
    </view>
  </view>

  <!-- 风险趋势 -->
  <view class="card risk-trend">
    <view class="card-header">
      <text class="card-title">风险趋势</text>
    </view>
    <view class="trend-chart">
      <view class="trend-bar" wx:for="{{trendData}}" wx:key="month">
        <view class="trend-fill" style="height: {{item.value}}%; background-color: {{item.color}}"></view>
        <text class="trend-label">{{item.month}}</text>
      </view>
    </view>
  </view>

  <!-- 风险分类 -->
  <view class="card risk-categories">
    <view class="card-header">
      <text class="card-title">风险分类</text>
    </view>
    <view class="category-list">
      <view class="category-item" wx:for="{{categories}}" wx:key="name" bindtap="viewCategory" data-name="{{item.name}}">
        <view class="category-left">
          <view class="category-icon" style="background-color: {{item.color}}">
            <text class="iconfont">{{item.icon}}</text>
          </view>
          <view class="category-info">
            <text class="category-name">{{item.name}}</text>
            <text class="category-desc">{{item.desc}}</text>
          </view>
        </view>
        <view class="category-right">
          <text class="category-count">{{item.count}}</text>
          <text class="category-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 详细风险列表 -->
  <view class="card detail-risks">
    <view class="card-header">
      <text class="card-title">详细风险</text>
      <view class="filter-tabs">
        <text
          class="tab-item {{activeTab === item.value ? 'active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="value"
          bindtap="switchTab"
          data-value="{{item.value}}"
        >
          {{item.name}}
        </text>
      </view>
    </view>
    <view class="risk-list">
      <view class="risk-item risk-{{item.level}}" wx:for="{{filteredRisks}}" wx:key="id" bindtap="viewRiskDetail" data-id="{{item.id}}">
        <view class="risk-badge">
          <text class="badge-text">{{item.levelText}}</text>
        </view>
        <view class="risk-content">
          <text class="risk-title">{{item.title}}</text>
          <text class="risk-desc">{{item.desc}}</text>
          <view class="risk-meta">
            <text class="meta-item">发现时间：{{item.time}}</text>
            <text class="meta-item">来源：{{item.source}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 改进建议 -->
  <view class="card suggestions">
    <view class="card-header">
      <text class="card-title">改进建议</text>
    </view>
    <view class="suggestion-list">
      <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="id">
        <view class="suggestion-number">{{index + 1}}</view>
        <view class="suggestion-content">
          <text class="suggestion-title">{{item.title}}</text>
          <text class="suggestion-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 导出按钮 -->
  <view class="action-buttons">
    <button class="btn btn-primary btn-block btn-large" bindtap="exportReport">
      导出报告
    </button>
    <button class="btn btn-outline btn-block" bindtap="shareReport">
      分享报告
    </button>
  </view>
</view>
