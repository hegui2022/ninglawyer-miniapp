<!-- 宁律师家族页面 -->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-icon">🔍</view>
    <input 
      class="search-input" 
      placeholder="搜索宁律师或法律问题" 
      bindconfirm="onSearch"
      confirm-type="search"
    />
  </view>

  <!-- 欢迎卡片 -->
  <view class="welcome-card">
    <view class="welcome-avatar">⚖️</view>
    <view class="welcome-content">
      <text class="welcome-title">👋 你好，我是宁律师</text>
      <text class="welcome-subtitle">有什么法律问题，我来帮你解答</text>
    </view>
  </view>

  <!-- 宁律师列表 -->
  <view class="section">
    <view class="section-title">宁律师家族</view>
    <view class="lawyer-grid">
      <view 
        class="lawyer-card"
        wx:for="{{lawyers}}"
        wx:key="id"
        bindtap="selectLawyer"
        data-domain="{{item.id}}"
      >
        <view class="lawyer-icon">{{item.icon}}</view>
        <text class="lawyer-name">{{item.name}}</text>
        <text class="lawyer-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <!-- 热门咨询 -->
  <view class="section">
    <view class="section-title">🔥 热门咨询</view>
    <view class="hot-consultations">
      <view 
        class="consultation-item"
        wx:for="{{hotConsultations}}"
        wx:key="*this"
        bindtap="onHotConsultation"
        data-domain="{{item.domain}}"
      >
        <view class="consultation-icon">{{item.icon}}</view>
        <view class="consultation-content">
          <text class="consultation-question">{{item.question}}</text>
          <view class="consultation-meta">
            <text class="consultation-count">{{item.count}}</text>
            <text class="consultation-lawyer">{{item.lawyer}}</text>
          </view>
        </view>
        <view class="consultation-arrow">›</view>
      </view>
    </view>
  </view>
</view>
