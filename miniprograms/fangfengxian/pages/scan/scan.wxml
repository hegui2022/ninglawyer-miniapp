<!--pages/scan/scan.wxml-->
<view class="container">
  <!-- 扫描类型选择 -->
  <view class="card scan-types">
    <view class="card-header">
      <text class="card-title">选择扫描类型</text>
    </view>
    <view class="type-list">
      <view
        class="type-item {{selectedType === item.value ? 'active' : ''}}"
        wx:for="{{scanTypes}}"
        wx:key="value"
        bindtap="selectType"
        data-value="{{item.value}}"
      >
        <image class="type-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="type-info">
          <text class="type-name">{{item.name}}</text>
          <text class="type-desc">{{item.desc}}</text>
        </view>
        <view class="type-check" wx:if="{{selectedType === item.value}}">
          <text class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 扫描范围 -->
  <view class="card scan-scope">
    <view class="card-header">
      <text class="card-title">扫描范围</text>
    </view>
    <view class="scope-options">
      <view
        class="scope-item {{scope === item.value ? 'active' : ''}}"
        wx:for="{{scopeOptions}}"
        wx:key="value"
        bindtap="selectScope"
        data-value="{{item.value}}"
      >
        <text class="scope-text">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 扫描选项 -->
  <view class="card scan-options">
    <view class="card-header">
      <text class="card-title">扫描选项</text>
    </view>
    <view class="option-list">
      <view class="option-item" wx:for="{{scanOptions}}" wx:key="key">
        <view class="option-label">
          <text class="option-name">{{item.name}}</text>
          <text class="option-desc">{{item.desc}}</text>
        </view>
        <switch
          checked="{{item.checked}}"
          bindchange="toggleOption"
          data-key="{{item.key}}"
          color="#07C160"
        />
      </view>
    </view>
  </view>

  <!-- 扫描进度 -->
  <view class="card scan-progress" wx:if="{{scanning}}">
    <view class="progress-header">
      <text class="progress-title">扫描中...</text>
      <text class="progress-percent">{{progress}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <view class="progress-info">
      <text class="progress-text">{{currentTask}}</text>
    </view>
  </view>

  <!-- 扫描结果 -->
  <view class="card scan-result" wx:if="{{!scanning && scanResult}}">
    <view class="result-header">
      <text class="result-title">扫描结果</text>
      <view class="result-badge risk-{{scanResult.level}}">
        <text>{{scanResult.levelText}}</text>
      </view>
    </view>
    <view class="result-stats">
      <view class="result-stat">
        <text class="stat-value">{{scanResult.total}}</text>
        <text class="stat-label">总项数</text>
      </view>
      <view class="result-stat">
        <text class="stat-value risk-high">{{scanResult.high}}</text>
        <text class="stat-label">高风险</text>
      </view>
      <view class="result-stat">
        <text class="stat-value risk-medium">{{scanResult.medium}}</text>
        <text class="stat-label">中风险</text>
      </view>
      <view class="result-stat">
        <text class="stat-value risk-low">{{scanResult.low}}</text>
        <text class="stat-label">低风险</text>
      </view>
    </view>
  </view>

  <!-- 风险列表 -->
  <view class="card risk-list" wx:if="{{!scanning && risks.length > 0}}">
    <view class="card-header">
      <text class="card-title">风险列表</text>
    </view>
    <view class="risk-items">
      <view class="risk-item risk-{{item.level}}" wx:for="{{risks}}" wx:key="id" bindtap="viewRiskDetail" data-id="{{item.id}}">
        <view class="risk-left">
          <view class="risk-icon">
            <text class="iconfont">⚠️</text>
          </view>
          <view class="risk-content">
            <text class="risk-title">{{item.title}}</text>
            <text class="risk-desc">{{item.desc}}</text>
          </view>
        </view>
        <view class="risk-right">
          <text class="risk-level">{{item.levelText}}</text>
          <text class="risk-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons" wx:if="{{!scanning}}">
    <button
      class="btn btn-primary btn-block btn-large"
      bindtap="startScan"
      wx:if="{{!scanResult}}"
    >
      开始扫描
    </button>
    <button
      class="btn btn-primary btn-block btn-large"
      bindtap="viewReport"
      wx:if="{{scanResult}}"
    >
      查看详细报告
    </button>
    <button
      class="btn btn-outline btn-block"
      bindtap="rescan"
      wx:if="{{scanResult}}"
    >
      重新扫描
    </button>
  </view>
</view>
