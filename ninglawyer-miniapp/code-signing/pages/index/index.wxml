<!-- 码上签约 - 首页 -->
<view class="index-page">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stats-header">
      <text class="stats-title">合同概览</text>
      <text class="stats-date">本月</text>
    </view>
    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-value">{{stats.total}}</text>
        <text class="stats-label">总合同</text>
      </view>
      <view class="stats-item">
        <text class="stats-value stats-success">{{stats.signed}}</text>
        <text class="stats-label">已签署</text>
      </view>
      <view class="stats-item">
        <text class="stats-value stats-warning">{{stats.pending}}</text>
        <text class="stats-label">待签署</text>
      </view>
    </view>
  </view>
  
  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-item" wx:for="{{quickActions}}" wx:key="id" bindtap="onQuickAction" data-url="{{item.url}}">
      <view class="action-icon">{{item.icon}}</view>
      <text class="action-title">{{item.title}}</text>
      <text class="action-desc">{{item.desc}}</text>
    </view>
  </view>
  
  <!-- 最近合同 -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">最近合同</text>
      <text class="section-more">查看全部 ></text>
    </view>
    
    <view class="contract-list">
      <view 
        class="contract-item" 
        wx:for="{{recentContracts}}" 
        wx:key="id"
        bindtap="onContractTap"
        data-id="{{item.id}}"
      >
        <view class="contract-left">
          <view class="contract-icon">📄</view>
          <view class="contract-info">
            <text class="contract-name">{{item.name}}</text>
            <text class="contract-type">{{item.type}}</text>
          </view>
        </view>
        <view class="contract-right">
          <view class="contract-status status-{{item.status}}">
            {{item.status === 'signed' ? '已签署' : '待签署'}}
          </view>
          <text class="contract-date">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 创建按钮 -->
  <view class="fab-section">
    <button class="fab-btn" bindtap="onQuickAction" data-url="/pages/create/create">
      <text class="fab-icon">+</text>
    </button>
  </view>
</view>
