<!-- 维权指导页面 -->
<view class="rights-page">
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === item.id ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTabChange"
    >
      {{item.name}}
    </view>
  </view>
  
  <!-- 维权流程 -->
  <view class="tab-content" wx:if="{{activeTab === 'process'}}">
    <view class="step-list">
      <view 
        class="step-item" 
        wx:for="{{steps}}" 
        wx:key="id"
        data-step="{{item}}"
        bindtap="onStepTap"
      >
        <view class="step-number">{{item.id}}</view>
        <view class="step-content">
          <text class="step-title">{{item.title}}</text>
          <text class="step-desc">{{item.description}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 法律条款 -->
  <view class="tab-content" wx:if="{{activeTab === 'law'}}">
    <view class="law-list">
      <view 
        class="law-card" 
        wx:for="{{laws}}" 
        wx:key="title"
        data-law="{{item}}"
        bindtap="onLawTap"
      >
        <text class="law-title">{{item.title}}</text>
        <text class="law-content">{{item.content}}</text>
      </view>
    </view>
  </view>
  
  <!-- 案例参考 -->
  <view class="tab-content" wx:if="{{activeTab === 'cases'}}">
    <view class="case-list">
      <view 
        class="case-card" 
        wx:for="{{referenceCases}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCaseTap"
      >
        <text class="case-title">{{item.title}}</text>
        <text class="case-court">{{item.court}}</text>
        <text class="case-result">结果：{{item.result}}</text>
        <text class="case-date">{{item.date}}</text>
      </view>
    </view>
  </view>
  
  <view class="consult-btn" bindtap="onConsult">
    <text>💬 咨询专业律师</text>
  </view>
</view>
